---
const foundationLinks = ["Donate", "About Us", "Media Room", "Advertising"];
const companyLinks = ["Careers at AOPA", "Aviation Jobs", "AOPA Gear", "Privacy Request"];
const bottomLinks = ["Terms of Use", "Cancellation and Refund Policy", "Privacy Policy"];

const headingClass = "font-national text-sm font-bold uppercase tracking-widest text-[#7ce0ff]";
const linkClass = "font-national text-base font-light text-white/85 no-underline hover:text-white";
---

<footer class="relative z-[1] bg-[#182f56] px-8 py-16 sm:px-12 lg:px-24">
	<div class="mx-auto max-w-[1600px]">
		<div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
			<div>
				<img src="/images/aopa/home/4/aopa-wings.svg" alt="" class="w-36 select-none" />
				<p class="mt-3 font-national text-3xl font-bold uppercase text-white">
					AOPA<sup class="ml-0.5 text-xs font-medium">&reg;</sup>
				</p>
				<p class="mt-3 font-national text-sm font-bold uppercase tracking-widest text-white">
					Aircraft Owners and Pilots Association
				</p>
				<p class="mt-4 max-w-xs font-national text-lg font-light leading-relaxed text-white/90">
					The world's largest aviation community, protecting your freedom to fly since 1939
				</p>
				<a
					href="#"
					class="mt-8 inline-flex items-center gap-6 rounded-full bg-white py-2 pl-8 pr-2 no-underline"
				>
					<span class="font-national text-sm font-bold uppercase tracking-widest text-[#182f56]">
						Join Now
					</span>
					<span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#182f56] text-white">
						<svg class="h-5 w-5 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
							<polygon
								fill="currentColor"
								points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
							/>
						</svg>
					</span>
				</a>
			</div>

			<div class="grid grid-cols-1 gap-12 sm:grid-cols-3 sm:gap-16 lg:gap-20">
				<div>
					<p class={headingClass}>Contact</p>
					<div class="mt-6 flex flex-col gap-4">
						<p class="font-national text-base font-light leading-relaxed text-white/90">
							421 Aviation Way<br />Frederick, MD, 21701
						</p>
						<a href="tel:8008722672" class={linkClass}>800.872.2672</a>
						<a href="#" class={linkClass}>Contact Us</a>
					</div>
				</div>

				<div>
					<p class={headingClass}>AOPA Foundation</p>
					<div class="mt-6 flex flex-col gap-3">
						{foundationLinks.map((label) => (
							<a href="#" class={linkClass}>{label}</a>
						))}
					</div>
				</div>

				<div>
					<p class={headingClass}>Company</p>
					<div class="mt-6 flex flex-col gap-3">
						{companyLinks.map((label) => (
							<a href="#" class={linkClass}>{label}</a>
						))}
					</div>
				</div>
			</div>
		</div>

		<div class="mt-16 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-white/15 pt-8">
			<p class="font-national text-sm font-light text-white/60">
				&copy; {new Date().getFullYear()} Aircraft Owners and Pilots Association. All rights reserved.
			</p>
			<div class="flex flex-wrap items-center gap-x-8 gap-y-2">
				{bottomLinks.map((label) => (
					<a href="#" class="font-national text-sm font-light text-white/70 no-underline hover:text-white">
						{label}
					</a>
				))}
			</div>
		</div>
	</div>
</footer>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const header = document.getElementById("home-header");
	let lastScrollY = window.scrollY;

	const updateHeaderState = () => {
		const currentScrollY = window.scrollY;

		if (currentScrollY <= 0) {
			header?.classList.remove("is-scrolled");
		} else if (currentScrollY > lastScrollY) {
			header?.classList.add("is-scrolled");
		} else if (currentScrollY < lastScrollY) {
			header?.classList.remove("is-scrolled");
		}

		lastScrollY = currentScrollY;
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });

	class FlairButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly icon: HTMLElement;
		private readonly arrow: SVGElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;
		private arrowRotation = 45;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-learn-more-4-flair")!;
			this.icon = button.querySelector<HTMLElement>(".js-learn-more-4-icon")!;
			this.arrow = button.querySelector<SVGElement>(".js-learn-more-4-arrow")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			gsap.set(this.arrow, { rotation: this.arrowRotation, transformOrigin: "50% 50%" });
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);

				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation += 45;

				const tl = gsap.timeline();
				tl.to(this.icon, { scale: 1.15, duration: 0.25, ease: "power2.out" }, 0)
					.to(this.icon, { scale: 1, duration: 0.6, ease: "elastic.out(1, 0.35)" }, 0.25)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.6, ease: "power3.out" }, 0);
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation = 45;
				gsap.to(this.icon, { scale: 1, duration: 0.3, ease: "power2.out" });
				gsap.to(this.arrow, { rotation: this.arrowRotation, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-learn-more-4").forEach((button) => new FlairButton(button));

	class PlaneRunwayButton {
		private readonly button: HTMLElement;
		private readonly plane: HTMLElement;

		constructor(button: HTMLElement) {
			this.button = button;
			this.plane = button.querySelector<HTMLElement>(".js-plane-runway-icon")!;
			this.initEvents();
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", () => {
				gsap.killTweensOf(this.plane);
				// the artwork itself is drawn banked upward, so level it out to fly horizontal
				gsap.set(this.plane, { x: 0, y: 0, rotation: 30, scale: 0, opacity: 0 });

				// runway spans the full length of the button, right out to its end
				const planeRect = this.plane.getBoundingClientRect();
				const buttonRect = this.button.getBoundingClientRect();
				const runway = buttonRect.right - planeRect.left - 8;

				// fixed timing regardless of button width: taxi always takes 1s, then a 1s
				// lift+climb tail. The x tween's distance is solved backwards so that its
				// power1.in easing (which accelerates as (t/duration)^2) places the plane
				// exactly at the runway's end when the taxi duration elapses - and since the
				// tail duration matches exactly what's left in the tween, x never stops
				// moving before the climb and fade-out finish.
				const taxiDuration = 1.3;
				const tailDuration = 1.3;
				const totalDuration = taxiDuration + tailDuration;
				const totalDistance = runway / (taxiDuration / totalDuration) ** 2;

				const tl = gsap.timeline();
				tl.to(this.plane, { scale: 1, opacity: 1, duration: 0.2, ease: "power2.out" })
					.addLabel("flight")
					// one continuous, ever-accelerating horizontal run: taxi, liftoff, and climb-away
					// are all the same x tween, running the full length of the timeline so it
					// never stalls out horizontally while the climb/fade finish above it
					.to(this.plane, { x: totalDistance, duration: totalDuration, ease: "power1.in" }, "flight")
					// angle up and lift off right at the end of the runway
					.to(this.plane, { y: -12, rotation: 20, duration: 0.5, ease: "power2.out" }, `flight+=${taxiDuration}`)
					// climb away on a shallow angle and fade out
					.to(this.plane, { y: -60, opacity: 0, duration: 0.9, ease: "power1.in" }, `flight+=${taxiDuration + 0.4}`);
			});

			this.button.addEventListener("mouseleave", () => {
				gsap.killTweensOf(this.plane);
				gsap.to(this.plane, { opacity: 0, scale: 0, duration: 0.2, ease: "power2.in" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-plane-runway-btn").forEach((button) => new PlaneRunwayButton(button));

	class ShieldButton {
		private readonly button: HTMLElement;
		private readonly words: HTMLElement[];
		private readonly flair: HTMLElement;
		private readonly shine: SVGElement;
		private readonly icon: HTMLElement;
		private readonly arrow: SVGElement;
		private arrowRotation = 45;

		constructor(button: HTMLElement) {
			this.button = button;
			this.words = Array.from(button.querySelectorAll<HTMLElement>(".js-shield-word-4"));
			this.flair = button.querySelector<HTMLElement>(".js-shield-flair-4")!;
			this.shine = button.querySelector<SVGElement>(".js-shield-shine-4")!;
			this.icon = button.querySelector<HTMLElement>(".js-shield-icon-4")!;
			this.arrow = button.querySelector<SVGElement>(".js-shield-arrow-4")!;
			gsap.set(this.arrow, { rotation: this.arrowRotation, transformOrigin: "50% 50%" });
			this.initEvents();
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", () => {
				gsap.killTweensOf([...this.words, this.flair, this.icon, this.arrow, this.shine]);
				gsap.set(this.flair, { x: 0, y: 0, rotation: 0, scale: 0, opacity: 0 });
				gsap.set(this.shine, { attr: { x: -260 } });
				this.arrowRotation += 45;

				const tl = gsap.timeline();
				tl.to(this.words[0], { x: -14, duration: 0.7, ease: "elastic.out(1, 0.5)" }, 0)
					.to(this.words[1], { x: 14, duration: 0.7, ease: "elastic.out(1, 0.5)" }, 0)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.6, ease: "power3.out" }, 0)
					// anticipation: rise into place, like the shield is being raised
					.to(
						this.flair,
						{ y: -6, rotation: 0, scale: 1, opacity: 1, duration: 0.5, ease: "elastic.out(1, 0.5)" },
						0.1,
					)
					// a light streak sweeps across the shield once it's settled, and holds there
					.to(this.shine, { attr: { x: 400 }, duration: 0.6, ease: "power1.inOut" })
					// pause a beat, then fade the shield out
					.to(this.flair, { opacity: 0, scale: 0.8, duration: 0.4, ease: "power2.in" }, "+=1")
					// once the shield is gone, elastic the words back together
					.to(this.words, { x: 0, duration: 0.6, ease: "elastic.out(1, 0.5)" });
			});

			this.button.addEventListener("mouseleave", () => {
				gsap.killTweensOf([...this.words, this.flair, this.icon, this.arrow, this.shine]);
				this.arrowRotation = 45;

				const tl = gsap.timeline();
				tl.to(this.words, { x: 0, duration: 0.3, ease: "power2.out" }, 0)
					.to(
						this.flair,
						{ x: 0, y: 0, rotation: 0, scale: 0, opacity: 0, duration: 0.3, ease: "power2.in" },
						0,
					)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.4, ease: "power2.out" }, 0);
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-shield-btn-4").forEach((button) => new ShieldButton(button));

	class FlairOnlyButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-flair-btn-flair")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);
				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-flair-btn").forEach((button) => new FlairOnlyButton(button));

	document.querySelectorAll<HTMLElement>(".js-reveal").forEach((el) => {
		gsap.from(el, {
			opacity: 0,
			y: 40,
			ease: "none",
			scrollTrigger: {
				trigger: el,
				start: "top 85%",
				end: "top 55%",
				scrub: 1,
			},
		});
	});

	const hubHero = document.querySelector<HTMLElement>(".js-hub-hero");
	const hubHeroBg = hubHero?.querySelector<HTMLElement>(".js-hub-hero-bg");

	if (hubHero && hubHeroBg) {
		gsap.fromTo(
			hubHeroBg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: hubHero,
					start: "top top",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	const hubHeroWatermarkSolid = hubHero?.querySelector<HTMLElement>(".js-hub-hero-watermark-solid");

	if (hubHero && hubHeroWatermarkSolid) {
		gsap.fromTo(
			hubHeroWatermarkSolid,
			{ opacity: 0 },
			{
				opacity: 1,
				ease: "none",
				scrollTrigger: {
					trigger: hubHero,
					start: "top top",
					end: "70% top",
					scrub: 1,
				},
			},
		);
	}

	[
		[".js-hub-advocacy", ".js-hub-advocacy-bg"],
		[".js-member-frame", ".js-member-bg"],
	].forEach(([sectionSelector, bgSelector]) => {
		const section = document.querySelector<HTMLElement>(sectionSelector);
		const bg = section?.querySelector<HTMLElement>(bgSelector);
		if (!section || !bg) return;

		gsap.fromTo(
			bg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: section,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	});

	const flightline = document.querySelector<SVGElement>(".js-flightline");
	const flightlinePath = flightline?.querySelector<SVGPathElement>(".js-flightline-path");
	const flightlineNodes = flightline?.querySelectorAll<SVGElement>(".js-flightline-node");
	const flightlineText = flightline?.querySelectorAll<SVGElement>(".js-flightline-text");

	if (flightline && flightlinePath) {
		const length = flightlinePath.getTotalLength();
		gsap.set(flightlinePath, { strokeDasharray: length, strokeDashoffset: length });

		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: flightline,
				start: "top 75%",
				end: "top 30%",
				scrub: 1,
			},
		});

		tl.to(flightlinePath, { strokeDashoffset: 0, ease: "none" });
		if (flightlineNodes?.length) {
			tl.to(flightlineNodes, { opacity: 1, ease: "none" }, "-=0.3");
		}
		if (flightlineText?.length) {
			tl.to(flightlineText, { opacity: 0.8, ease: "none" }, "-=0.2");
		}
	}


	document.querySelectorAll<HTMLElement>(".js-faq-q").forEach((btn) => {
		btn.addEventListener("click", () => {
			const item = btn.closest<HTMLElement>(".js-faq-item")!;
			const wasOpen = item.classList.contains("is-open");
			item.parentElement?.querySelectorAll<HTMLElement>(".js-faq-item").forEach((i) => i.classList.remove("is-open"));
			if (!wasOpen) item.classList.add("is-open");
		});
	});

	window.addEventListener("load", () => ScrollTrigger.refresh());
</script>

---
import HubFooter from "../../../../components/aopa/HubFooter.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Airmen, AOPA Advocacy</title>
</head>
<body>

<div class="home">
	<header class="home__header" id="home-header">
		<img class="home__chrome" src="/images/aopa/home/1/chrome-100.jpg" alt="" />
		<img class="home__mini-nav" src="/images/aopa/home/1/mini-nav-100.jpg" alt="" />
	</header>

	<section class="js-hub-hero hub-hero relative overflow-hidden bg-white">
		<div class="flex min-h-[calc(97vh-var(--chrome-h))] flex-col lg:flex-row">
			<div class="flex w-full flex-col lg:w-1/2">
				<p class="px-8 pt-8 font-national font-light text-[#182f56]/80 sm:px-12 lg:px-16">
					<a href="/" class="text-[#182f56] no-underline hover:underline">Home</a>
					<span aria-hidden="true">›</span>
					<a href="/aopa/hub/advocacy" class="text-[#182f56] no-underline hover:underline">Advocacy</a>
					<span aria-hidden="true">›</span> Airmen
				</p>
				<div class="flex flex-1 flex-col justify-center px-8 py-12 sm:px-12 lg:px-16">
					<h1 class="max-w-[16ch] font-bold text-4xl leading-[1.05] tracking-tight text-[#182f56] sm:text-5xl">
						The rules that are about you, not your airplane.
					</h1>
					<p class="mt-5 max-w-[42ch] font-national text-lg font-light leading-relaxed text-gray-500 sm:text-xl">
						Medical reform, certification and proficiency, flight training security, and due process
						when the FAA comes calling.
					</p>
					<a
						href="#"
						class="mt-6 inline-block font-national text-base font-medium text-[#01a2e0] no-underline hover:underline"
					>
						See Where Medical Reform Stands
					</a>
				</div>
			</div>

			<div class="relative min-h-[360px] w-full overflow-hidden lg:min-h-0 lg:w-1/2">
				<img
					class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
					src="/images/aopa/hub/subhub/preflight.jpg"
					alt=""
				/>
				<div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-end overflow-hidden pr-8 sm:pr-10 lg:pr-12">
					<span class="translate-y-[0.2em] font-national text-[4.5rem] font-bold uppercase leading-none text-[#1d3f6d] sm:text-[6rem] lg:text-[10rem]">
						Airmen
					</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== DO SOMETHING NOW ===== -->
	<section class="relative overflow-hidden bg-[#1d3f6d] px-8 py-24 sm:px-12 lg:px-24">
		<div class="mx-auto max-w-7xl">
			<p class="font-national text-2xl font-light italic text-white">Do Something Now</p>
			<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
				<a href="#" class="rounded-2xl bg-gray-100 px-6 py-6 font-national text-lg font-bold leading-snug text-[#182f56] no-underline hover:text-[#01a2e0]">
					Check your flight training security obligations
				</a>
				<a href="#" class="rounded-2xl bg-gray-100 px-6 py-6 font-national text-lg font-bold leading-snug text-[#182f56] no-underline hover:text-[#01a2e0]">
					If you received a letter of investigation
				</a>
				<a href="#" class="rounded-2xl bg-gray-100 px-6 py-6 font-national text-lg font-bold leading-snug text-[#182f56] no-underline hover:text-[#01a2e0]">
					Comment on a proposed rule
				</a>
			</div>
		</div>
	</section>

	<!-- ===== CARDS ===== -->
	<section class="js-tool-module relative overflow-hidden bg-white px-8 py-36 sm:px-12 lg:px-24">
		<div class="relative mx-auto max-w-7xl">
			<div class="mb-14 flex flex-wrap items-center justify-between gap-8">
				<h2 class="max-w-[20ch] font-national text-3xl font-medium text-[#182f56] sm:text-4xl">
					<span class="font-light italic">Explore</span> by topic
				</h2>
			</div>

			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<a href="#" class="relative isolate flex min-h-[200px] flex-col justify-start gap-3 overflow-hidden rounded-lg bg-[#182f56] p-7 no-underline">
					<div class="relative">
						<span class="block font-national text-xl font-medium text-[#7ce0ff]">BasicMed and Medical Reform</span>
						<p class="mt-2 font-national text-lg font-light text-white">
							Where third class medical reform stands, what has already changed, and what AOPA is still fighting for.
						</p>
					</div>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">BasicMed →</span>
				</a>
				<a href="#" class="relative isolate flex min-h-[200px] flex-col justify-start gap-3 overflow-hidden rounded-lg border border-white/10 bg-[#182f56] p-7 no-underline">
					<div class="relative">
						<span class="block font-national text-xl font-medium text-[#7ce0ff]">Flight Training Security Program</span>
						<p class="mt-2 font-national text-lg font-light text-white">
							What the TSA rule requires of a flight training provider, who has to be vetted, and by when.
						</p>
					</div>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">Flight Training Security Program →</span>
				</a>
				<a href="#" class="relative isolate flex min-h-[200px] flex-col justify-start gap-3 overflow-hidden rounded-lg border border-white/10 bg-[#182f56] p-7 no-underline">
					<div class="relative">
						<span class="block font-national text-xl font-medium text-[#7ce0ff]">Pilot Regulation</span>
						<p class="mt-2 font-national text-lg font-light text-white">
							Airman certification and proficiency rules, and how to weigh in while they are still being written.
						</p>
					</div>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">Pilot Regulation →</span>
				</a>
				<a href="#" class="relative isolate flex min-h-[200px] flex-col justify-start gap-3 overflow-hidden rounded-lg border border-white/10 bg-[#182f56] p-7 no-underline">
					<div class="relative">
						<span class="block font-national text-xl font-medium text-[#7ce0ff]">Pilot's Bill of Rights 2</span>
						<p class="mt-2 font-national text-lg font-light text-white">
							What the law gives a pilot facing FAA enforcement: notice, access to the evidence, and a real appeal.
						</p>
					</div>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">Pilot's Bill of Rights 2 →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ===== PROOF (STATS) + AOPA IN ACTION ===== -->
	<section class="js-advocacy-proof relative overflow-hidden bg-[#1d3f6d] px-8 py-36 sm:px-12 lg:px-24">
		<img
			class="js-advocacy-proof-bg pointer-events-none absolute inset-x-0 -top-[100%] h-[300%] w-full select-none object-cover will-change-transform"
			src="/images/aopa/home/4/sky-portrait.jpg"
			alt=""
		/>
		<div class="pointer-events-none absolute inset-0 bg-[#1d3f6d]/55"></div>

		<div class="relative mx-auto max-w-7xl">
			<h2 class="js-reveal mb-14 max-w-[30ch] font-national text-3xl font-medium text-white sm:text-4xl">
				What the rules actually require
			</h2>

			<div class="js-reveal mb-20 grid grid-cols-1 gap-10 sm:grid-cols-3">
				<a href="#" class="no-underline">
					<div class="font-national text-3xl font-bold text-[#7ce0ff]">July 30, 2024</div>
					<p class="mt-3 font-national text-xl font-medium text-white">
						Flight Training Security Program rule took effect
					</p>
					<p class="mt-2 font-national text-lg font-light italic text-white/80">
						Providers must "verify U.S. citizenship of trainees, give security awareness initial
						and biennial training to their employees, and designate a security coordinator with
						the TSA."
					</p>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">
						Flight Training Security Program →
					</span>
				</a>
				<a href="#" class="no-underline">
					<div class="font-national text-3xl font-bold text-[#7ce0ff]">Each day</div>
					<p class="mt-3 font-national text-xl font-medium text-white">
						counts as a separate occurrence subject to penalty
					</p>
					<p class="mt-2 font-national text-lg font-light italic text-white/80">
						"TSA considers each day a person operates in violation to the requirements of the
						rule an additional occurrence subject to penalty."
					</p>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">
						AOPA's guide to the rule →
					</span>
				</a>
				<a href="#" class="no-underline">
					<div class="font-national text-3xl font-bold text-[#7ce0ff]">60 days · 2 yrs · 5 yrs</div>
					<p class="mt-3 font-national text-xl font-medium text-white">
						training due · refresh cycle · records held
					</p>
					<p class="mt-2 font-national text-lg font-light text-white/80">
						Security awareness training is due within 60 days, refreshed every two years, with
						citizenship records held for five.
					</p>
					<span class="mt-3 inline-block font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">
						Security awareness training →
					</span>
				</a>
			</div>

			<div class="js-reveal grid gap-10 rounded-lg bg-[#0d1b2a]/50 p-10 lg:grid-cols-2 lg:items-center">
				<div>
					<div class="mb-3 font-national font-bold uppercase tracking-widest text-[#7ce0ff]">
						AOPA in Action
					</div>
					<h3 class="max-w-[26ch] font-national text-2xl font-medium text-white">
						One vote closer on mental health and the medical
					</h3>
					<p class="mt-4 max-w-[52ch] font-national font-light leading-relaxed text-white/90">
						The Senate Commerce Committee voted unanimously on April 14, 2026 to advance the
						Mental Health in Aviation Act, which would modernize how the FAA certificates pilots
						who seek treatment and address examiner shortages and special issuance delays. The
						House passed its version in September 2025.
					</p>
					<blockquote class="mt-4 max-w-[48ch] font-national text-lg font-light italic leading-snug text-white">
						"Pilots should feel confident, should they need to seek treatment, without fear of
						possibly losing their livelihood." — Jim Coon, AOPA SVP government affairs
					</blockquote>
					<a
						href="#"
						class="mt-5 inline-flex items-center gap-2 font-national text-lg font-bold uppercase tracking-widest text-[#7ce0ff] no-underline"
					>
						See what we're fighting for
					</a>
					<p class="mt-4 font-national text-sm font-light text-white/50">
						Source: AOPA news, April 15, 2026
					</p>
				</div>
				<div class="js-advocacy-proof-photo relative min-h-[280px] overflow-hidden rounded-lg">
					<img
						src="/images/aopa/home/4/advocacy/c182-flying.jpg"
						alt=""
						class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== TAKE ACTION ===== -->
	<section class="relative overflow-hidden bg-white px-8 py-24 sm:px-12 lg:px-24">
		<div class="mx-auto max-w-3xl text-center">
			<h3 class="font-national text-4xl font-medium text-[#182f56]">
				<span class="font-light italic">The fight is the benefit,</span> and it runs whether or not
				you are watching.
			</h3>
			<p class="mx-auto mt-4 max-w-[50ch] font-national text-2xl font-light text-gray-500">
				Membership funds the people in the room; a gift to the Aviation Advocacy Fund covers what
				dues cannot.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a
					href="#"
					class="js-learn-more-4 js-plane-runway-btn relative inline-flex items-center gap-7 rounded-full bg-[#182f56] py-2 pl-10 pr-2 no-underline"
				>
					<span class="pointer-events-none absolute inset-0 overflow-hidden rounded-full" aria-hidden="true">
						<span
							class="js-learn-more-4-flair pointer-events-none absolute inset-0 origin-top-left scale-0 will-change-transform"
							aria-hidden="true"
						>
							<span class="absolute left-0 top-0 aspect-square w-[260%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#5b9bd5] opacity-40"></span>
						</span>
					</span>
					<span class="pointer-events-none absolute inset-0" aria-hidden="true">
						<span class="js-plane-runway-icon absolute left-6 top-[-4px] grid h-6 w-6 -translate-y-1/2 place-items-center text-[#5b9bd5] opacity-0">
							<svg viewBox="0 0 32 32" fill="currentColor" class="h-full w-full">
								<path d="M30.79,10.85l-2.33-2.99v-.02c-1.57-1.92-4.3-2.4-6.42-1.14l-6.45,3.85-6.74-2.48c-.23-.08-.47-.08-.7,0l-.9.34-.04.02c-1.02.44-1.48,1.61-1.05,2.63.11.26.28.49.48.68l2.73,2.65-2.52,1.52-3.53-1.19c-.25-.08-.52-.07-.76.05l-.38.18c-1.01.45-1.46,1.63-1.01,2.64.11.24.26.45.45.63l4.5,4.41h.01c.92.89,2.14,1.37,3.41,1.37.89,0,1.76-.24,2.53-.69l18.43-11c.47-.28.63-.9.35-1.37-.02-.04-.04-.07-.07-.1h0Z" />
							</svg>
						</span>
					</span>
					<span class="js-learn-more-4-label relative font-national font-medium uppercase tracking-widest text-white">
						Join AOPA
					</span>
					<span
						class="js-learn-more-4-icon relative grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-[#182f56]"
						aria-hidden="true"
					>
						<svg class="js-learn-more-4-arrow h-8 w-8 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
							<polygon
								fill="currentColor"
								points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
							/>
						</svg>
					</span>
				</a>
				<a
					href="#"
					class="inline-flex items-center justify-center rounded-full border border-[#182f56]/20 px-7 py-3.5 font-national text-[0.95rem] font-bold text-[#182f56] no-underline"
				>
					Support the Fight
				</a>
			</div>
		</div>
	</section>

	<!-- ===== FAQ + ELSEWHERE + PROVENANCE ===== -->
	<section class="relative overflow-hidden bg-[#f2f2f2] px-8 py-24 sm:px-12 lg:px-24">
		<div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[1.3fr_1fr]">
			<div>
				<h2 class="mb-8 font-national text-3xl font-medium text-[#182f56]">
					<span class="font-light italic">Questions</span> Pilots Ask
				</h2>

				<div class="js-faq border-t border-[#182f56]/10">
				<div class="js-faq-item is-open border-b border-[#182f56]/10">
					<button type="button" class="js-faq-q flex w-full items-center justify-between gap-4 py-5 text-left text-xl font-national text-base font-bold text-[#182f56]">
						Do I need a medical certificate to fly under BasicMed?
						<span class="js-faq-plus font-national text-xl font-light text-[#01a2e0]">+</span>
					</button>
					<div class="js-faq-a overflow-hidden">
						<p class="mb-5 font-national text-lg font-light leading-relaxed text-gray-500">
							No — BasicMed lets most pilots fly without a full FAA medical exam, provided you've
							held a regular medical certificate at some point since 2006 and complete the
							program's requirements.
						</p>
					</div>
				</div>
				<div class="js-faq-item border-b border-[#182f56]/10">
					<button type="button" class="js-faq-q flex w-full text-xl items-center justify-between gap-4 py-5 text-left font-national text-base font-bold text-[#182f56]">
						What does the TSA Flight Training Security Program require of my school?
						<span class="js-faq-plus font-national text-xl font-light text-[#01a2e0]">+</span>
					</button>
					<div class="js-faq-a overflow-hidden">
						<p class="mb-5 font-national text-lg font-light leading-relaxed text-gray-500">
							Providers must verify U.S. citizenship of trainees, give security awareness
							training to employees, and designate a security coordinator with the TSA.
						</p>
					</div>
				</div>
				<div class="js-faq-item border-b border-[#182f56]/10">
					<button type="button" class="js-faq-q flex w-full items text-xl items-center justify-between gap-4 py-5 text-left font-national  font-bold text-[#182f56]">
						What are my rights if the FAA opens an investigation?
						<span class="js-faq-plus font-national text-xl font-light text-[#01a2e0]">+</span>
					</button>
					<div class="js-faq-a overflow-hidden">
						<p class="mb-5 font-national text-lg font-light leading-relaxed text-gray-500">
							The Pilot's Bill of Rights 2 guarantees notice, access to the evidence against you,
							and a real appeal process before the FAA can act.
						</p>
					</div>
				</div>
				<div class="js-faq-item border-b border-[#182f56]/10">
					<button type="button" class="js-faq-q flex w-full items text-xl items-center justify-between gap-4 py-5 text-left font-national  font-bold text-[#182f56]">
						Where is the Mental Health in Aviation Act now?
						<span class="js-faq-plus font-national text-xl font-light text-[#01a2e0]">+</span>
					</button>
					<div class="js-faq-a overflow-hidden">
						<p class="mb-5 font-national text-lg font-light leading-relaxed text-gray-500">
							The Senate Commerce Committee advanced it unanimously on April 14, 2026; the House
							passed its version in September 2025.
						</p>
					</div>
				</div>
			</div>
			</div>

			<div class="flex flex-col gap-10">
				<div>
					<p class="font-national text-sm font-bold uppercase tracking-widest text-[#182f56]">
						Elsewhere on aopa.org
					</p>
					<ul class="mt-4 list-none space-y-2 p-0 font-national text-lg text-[#182f56]">
						<li><a href="#" class="text-[#182f56] no-underline hover:text-[#01a2e0]">Go Fly → Medical Resources</a></li>
						<li><a href="#" class="text-[#182f56] no-underline hover:text-[#01a2e0]">Advocacy → Briefs</a></li>
						<li><a href="/aopa/hub/advocacy" class="text-[#182f56] no-underline hover:text-[#01a2e0]">Advocacy (hub)</a></li>
					</ul>
				</div>

				<p class="border-t border-[#182f56]/10 pt-6 font-national text-sm font-light text-gray-500">
					Reviewed by AOPA government affairs (named) · Last updated [DATE]
				</p>
			</div>
		</div>
	</section>

	<HubFooter />
</div>

<style>
	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-bold.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-bold-italic.woff2") format("woff2");
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-regular-italic.woff2") format("woff2");
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-medium.woff2") format("woff2");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-medium-italic.woff2") format("woff2");
		font-weight: 500;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-light.woff2") format("woff2");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-light-italic.woff2") format("woff2");
		font-weight: 300;
		font-style: italic;
		font-display: swap;
	}

	.font-national {
		font-family: "National", system-ui, -apple-system, sans-serif;
		font-variant-numeric: lining-nums;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	.home {
		position: relative;
		width: 100%;
		--chrome-h: calc(100vw * 127 / 2100);
		--mini-nav-h: calc(100vw * 76 / 2100);
	}

	.home__header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		height: var(--chrome-h);
		overflow: hidden;
		transition: height 0.4s ease;
	}

	.home__header.is-scrolled {
		height: var(--mini-nav-h);
	}

	.home__chrome,
	.home__mini-nav {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: auto;
		transition: transform 0.4s ease;
	}

	.home__chrome {
		transform: translateY(0);
	}

	.home__mini-nav {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__chrome {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__mini-nav {
		transform: translateY(0);
	}

	.hub-hero {
		padding-top: var(--chrome-h);
	}

	.js-faq {
		min-height: 380px;
	}

	.js-faq-a {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.35s ease;
	}

	.js-faq-item.is-open .js-faq-a {
		grid-template-rows: 1fr;
	}

	.js-faq-a > p {
		min-height: 0;
		overflow: hidden;
	}

	.js-faq-plus {
		display: inline-block;
		transition: transform 0.25s ease;
	}

	.js-faq-item.is-open .js-faq-plus {
		transform: rotate(45deg);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const header = document.getElementById("home-header");
	let lastScrollY = window.scrollY;

	const updateHeaderState = () => {
		const currentScrollY = window.scrollY;

		if (currentScrollY <= 0) {
			header?.classList.remove("is-scrolled");
		} else if (currentScrollY > lastScrollY) {
			header?.classList.add("is-scrolled");
		} else if (currentScrollY < lastScrollY) {
			header?.classList.remove("is-scrolled");
		}

		lastScrollY = currentScrollY;
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });

	class FlairButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly icon: HTMLElement;
		private readonly arrow: SVGElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;
		private arrowRotation = 45;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-learn-more-4-flair")!;
			this.icon = button.querySelector<HTMLElement>(".js-learn-more-4-icon")!;
			this.arrow = button.querySelector<SVGElement>(".js-learn-more-4-arrow")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			gsap.set(this.arrow, { rotation: this.arrowRotation, transformOrigin: "50% 50%" });
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);

				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation += 45;

				const tl = gsap.timeline();
				tl.to(this.icon, { scale: 1.15, duration: 0.25, ease: "power2.out" }, 0)
					.to(this.icon, { scale: 1, duration: 0.6, ease: "elastic.out(1, 0.35)" }, 0.25)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.6, ease: "power3.out" }, 0);
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation = 45;
				gsap.to(this.icon, { scale: 1, duration: 0.3, ease: "power2.out" });
				gsap.to(this.arrow, { rotation: this.arrowRotation, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-learn-more-4").forEach((button) => new FlairButton(button));

	class PlaneRunwayButton {
		private readonly button: HTMLElement;
		private readonly plane: HTMLElement;

		constructor(button: HTMLElement) {
			this.button = button;
			this.plane = button.querySelector<HTMLElement>(".js-plane-runway-icon")!;
			this.initEvents();
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", () => {
				gsap.killTweensOf(this.plane);
				// the artwork itself is drawn banked upward, so level it out to fly horizontal
				gsap.set(this.plane, { x: 0, y: 0, rotation: 30, scale: 0, opacity: 0 });

				// runway spans the full length of the button, right out to its end
				const planeRect = this.plane.getBoundingClientRect();
				const buttonRect = this.button.getBoundingClientRect();
				const runway = buttonRect.right - planeRect.left - 8;

				// fixed timing regardless of button width: taxi always takes 1s, then a 1s
				// lift+climb tail. The x tween's distance is solved backwards so that its
				// power1.in easing (which accelerates as (t/duration)^2) places the plane
				// exactly at the runway's end when the taxi duration elapses - and since the
				// tail duration matches exactly what's left in the tween, x never stops
				// moving before the climb and fade-out finish.
				const taxiDuration = 1.3;
				const tailDuration = 1.3;
				const totalDuration = taxiDuration + tailDuration;
				const totalDistance = runway / (taxiDuration / totalDuration) ** 2;

				const tl = gsap.timeline();
				tl.to(this.plane, { scale: 1, opacity: 1, duration: 0.2, ease: "power2.out" })
					.addLabel("flight")
					// one continuous, ever-accelerating horizontal run: taxi, liftoff, and climb-away
					// are all the same x tween, running the full length of the timeline so it
					// never stalls out horizontally while the climb/fade finish above it
					.to(this.plane, { x: totalDistance, duration: totalDuration, ease: "power1.in" }, "flight")
					// angle up and lift off right at the end of the runway
					.to(this.plane, { y: -12, rotation: 20, duration: 0.5, ease: "power2.out" }, `flight+=${taxiDuration}`)
					// climb away on a shallow angle and fade out
					.to(this.plane, { y: -60, opacity: 0, duration: 0.9, ease: "power1.in" }, `flight+=${taxiDuration + 0.4}`);
			});

			this.button.addEventListener("mouseleave", () => {
				gsap.killTweensOf(this.plane);
				gsap.to(this.plane, { opacity: 0, scale: 0, duration: 0.2, ease: "power2.in" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-plane-runway-btn").forEach((button) => new PlaneRunwayButton(button));

	class FlairOnlyButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-flair-btn-flair")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);
				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-flair-btn").forEach((button) => new FlairOnlyButton(button));

	[
		[".js-advocacy-proof", ".js-advocacy-proof-bg"],
	].forEach(([sectionSelector, bgSelector]) => {
		const section = document.querySelector<HTMLElement>(sectionSelector);
		const bg = section?.querySelector<HTMLElement>(bgSelector);
		if (!section || !bg) return;

		gsap.fromTo(
			bg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: section,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	});

	document.querySelectorAll<HTMLElement>(".js-advocacy-proof .js-reveal").forEach((el) => {
		gsap.from(el, {
			opacity: 0,
			y: 40,
			ease: "none",
			scrollTrigger: {
				trigger: el,
				start: "top 85%",
				end: "top 55%",
				scrub: 1,
			},
		});
	});

	document.querySelectorAll<HTMLElement>(".js-faq-q").forEach((btn) => {
		btn.addEventListener("click", () => {
			const item = btn.closest<HTMLElement>(".js-faq-item")!;
			const wasOpen = item.classList.contains("is-open");
			item.parentElement?.querySelectorAll<HTMLElement>(".js-faq-item").forEach((i) => i.classList.remove("is-open"));
			if (!wasOpen) item.classList.add("is-open");
		});
	});

	window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
</body>
</html>

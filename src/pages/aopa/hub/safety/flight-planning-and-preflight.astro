---
import HubFooter from "../../../../components/aopa/HubFooter.astro";

const ICONS: Record<string, string> = {
	monitor:
		'<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
	video:
		'<path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2" ry="2"/>',
	alert:
		'<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
	help: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
	file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
	clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1" fill="currentColor"/>',
	award: '<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>',
	shield:
		'<path d="M20 13c0 5-3.5 7.5-7.35 8.88a1 1 0 0 1-.6 0C8.15 20.5 4.65 18 4.65 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C15.15 3.8 17.65 5 19.65 5a1 1 0 0 1 1 1z"/><path d="m9.5 12 2 2 4-4"/>',
};

interface ItemMeta {
	length: string;
	topic: string;
	wings?: string;
	accidentForgiveness?: string;
}

interface Item {
	title: string;
	description?: string;
	linkLabel?: string;
	meta?: ItemMeta;
}

interface Group {
	label: string;
	icon: keyof typeof ICONS;
	type?: "courses" | "videos" | "accident" | "list";
	items: Item[];
}

const groups: Group[] = [
	{
		label: "Online Courses",
		icon: "monitor",
		type: "courses",
		items: [
			{
				title: "Runway Safety",
				meta: {
					length: "45 mins",
					topic: "Flight Operations, Risk Management",
					wings: "Eligible*",
					accidentForgiveness: "Eligible*",
				},
			},
			{
				title: "Public Benefit Flying",
				meta: { length: "30 mins", topic: "Flight Operations" },
			},
			{
				title: "Weather Wise: VFR into IMC",
				meta: {
					length: "40 mins",
					topic: "Weather, Decision Making",
					wings: "Eligible*",
					accidentForgiveness: "Eligible*",
				},
			},
			{
				title: "Weather or Not: Thunderstorm Challenge",
				meta: { length: "25 mins", topic: "Weather" },
			},
		],
	},
	{
		label: "Videos",
		icon: "video",
		type: "videos",
		items: [
			{ title: "Air Safety Tip: Box the Controls" },
			{ title: "Beyond Proficient: Flying to Catalina Island" },
			{ title: "Weather Wise Series" },
			{ title: "The Passenger Safety Briefing" },
			{ title: "Invasive Species" },
			{ title: "Reality Check – Actual vs. POH: Takeoff and Landing Performance" },
			{ title: "Reality Check: The Runway Behind You" },
			{ title: "Pilot Short Stories: Heavy Load" },
			{ title: "Real Pilot Stories: Pressure over the Atlantic" },
			{ title: "Real Pilot Stories: The Heat of the Moment" },
		],
	},
	{
		label: "Accident Analysis",
		icon: "alert",
		type: "accident",
		items: [
			{
				title: "High Aspirations",
				meta: {
					length: "14:15 mins",
					topic: "Aeronautical Decision Making, IFR Procedures",
					wings: "Not Eligible",
					accidentForgiveness: "Eligible",
				},
			},
			{
				title: "Accident Case Study: Into Thin Air",
				meta: {
					length: "11:40 mins",
					topic: "Density Altitude, Mountain Flying",
					wings: "Eligible*",
					accidentForgiveness: "Eligible*",
				},
			},
			{
				title: "Accident Case Study: Faulty Assumptions",
				meta: {
					length: "9:05 mins",
					topic: "Aeronautical Decision Making",
					wings: "Not Eligible",
					accidentForgiveness: "Not Eligible",
				},
			},
			{
				title: "Accident Case Study: Just a Short Flight",
				meta: {
					length: "8:30 mins",
					topic: "Risk Management, Weather",
					wings: "Eligible*",
					accidentForgiveness: "Eligible*",
				},
			},
			{
				title: "Accident Case Study: Trapped in Ice",
				meta: {
					length: "12:50 mins",
					topic: "Icing, Weather",
					wings: "Eligible*",
					accidentForgiveness: "Not Eligible",
				},
			},
		],
	},
	{
		label: "Safety Quizzes",
		icon: "help",
		items: [
			{ title: "Aircraft Preflight" },
			{ title: "Airspace Review" },
			{ title: "Cold Weather Ops" },
			{ title: "Density Altitude" },
			{ title: "Hamburger Hop at Night" },
			{ title: "Mountain Flying" },
			{ title: "Night Operations" },
			{ title: "Practical Weather" },
			{ title: "Special Use Airspace" },
			{ title: "VFR Flight: Fond du Lac to Festus" },
		],
	},
	{
		label: "Publications",
		icon: "file",
		items: [
			{ title: "Airspace Flash Cards" },
			{ title: "Aircraft Flash Cards" },
			{ title: "Runway Flash Cards" },
			{ title: "Personal Minimums Contract – VFR" },
			{ title: "Personal Minimums Contract – IFR" },
			{ title: "Ramp Operations" },
			{ title: "TFRs" },
			{ title: "Volunteer Operations Safety Spotlight" },
			{ title: "PIREPs Made Easy Safety Spotlight" },
			{ title: "Weather Wise: Air Masses and Fronts Safety Spotlight" },
			{ title: "Weather Wise: Precipitation and Icing Safety Spotlight" },
			{ title: "Density Altitude: Beware of Thin Air Article and Poster" },
			{ title: "Mountain Flying Safety Spotlight" },
			{ title: "AOPA Air Safety Institute", linkLabel: "Read More" },
		],
	},
];

const slugify = (label: string) =>
	label
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Flight Planning and Preflight | AOPA</title>
	<meta
		name="description"
		content="Know before you go: courses, videos, quizzes, and publications to help you navigate the flight service system and prepare for your next flight."
	/>
</head>
<body>

<div class="home">
	<header class="home__header" id="home-header">
		<img class="home__chrome" src="/images/aopa/home/1/chrome-100.jpg" alt="" />
		<img class="home__mini-nav" src="/images/aopa/home/1/mini-nav-100.jpg" alt="" />
	</header>

	<section class="js-hub-hero hub-hero relative overflow-hidden bg-white">
		<div class="flex min-h-[calc(55vh-var(--chrome-h))] flex-col lg:flex-row">
			<div class="flex w-full flex-col justify-center px-8 py-12 sm:px-12 sm:py-16 lg:w-1/2 lg:px-24">
				<p class="font-national font-light text-[#182f56]/80">
					<a href="/" class="text-[#182f56] no-underline hover:underline">Home</a>
					<span aria-hidden="true">›</span>
					<a href="/aopa/hub/safety" class="text-[#182f56] no-underline hover:underline">Safety</a>
					<span aria-hidden="true">›</span> Flight Planning and Preflight
				</p>
				<h1 class="mt-6 max-w-[22ch] font-national font-extrabold text-4xl leading-[1.05] tracking-tight text-gray-800 sm:text-5xl">
					Flight Planning and Preflight
				</h1>
				<p class="mt-5 max-w-[65ch] font-national text-lg font-light leading-relaxed text-gray-500 sm:text-xl">
					The Air Safety Institute wants you to “know before you go.” Whether it's a quick hop
					to a nearby strip or an epic cross-country voyage, this Safety Center's courses,
					videos, and quizzes will help you navigate the flight service system and prepare
					for your next flight.
				</p>
			</div>

			<div class="relative min-h-[280px] w-full overflow-hidden lg:min-h-0 lg:w-1/2">
				<img
					class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
					src="/images/aopa/hub/preflight-planning.jpg"
					alt=""
				/>
			</div>
		</div>
	</section>

	<nav class="relative overflow-hidden bg-[#182f56] px-8 py-8 sm:px-12 lg:px-24" aria-label="On this page">
		<div class="mx-auto flex max-w-7xl flex-col flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center">
			<span class="font-national text-sm font-bold uppercase tracking-widest text-white/60">On This Page</span>
			<ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 p-0">
				{groups.map((group) => (
					<li class="list-none">
						<a
							href={`#${slugify(group.label)}`}
							class="flex items-center gap-2 font-national text-base font-medium text-white no-underline hover:underline"
						>
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="#7ce0ff"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={ICONS[group.icon]}
							/>
							{group.label}
							<span class="font-national text-sm font-light text-white/50">{group.items.length}</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</nav>

	{groups.map((group, i) => {
		const [featured, ...rest] = group.items;
		return (
			<>
			<section
				id={slugify(group.label)}
				class:list={["relative overflow-hidden scroll-mt-24 px-8 py-16 sm:px-12 lg:px-24", i % 2 === 0 ? "bg-gray-100" : "bg-white"]}
			>
				<div class="mx-auto max-w-7xl">
					<div class="mb-6 flex items-center gap-3">
						<svg
							width="28"
							height="28"
							viewBox="0 0 24 24"
							fill="none"
							stroke="#0b57d0"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							set:html={ICONS[group.icon]}
						/>
						<h2 class="font-national text-2xl font-extrabold text-gray-800 sm:text-3xl">
							{group.label}
						</h2>
					</div>

					{group.type === "courses" ? (
						<>
							<a
								href="#"
								class="flex flex-col overflow-hidden rounded-lg border border-black/10 bg-white no-underline lg:flex-row"
							>
								<div class="relative flex min-h-[200px] items-center justify-center bg-[#182f56] lg:w-[35%]">
									<span class="font-national text-sm font-light text-white/40">Course image</span>
								</div>
								<div class="flex flex-1 flex-col justify-center gap-3 p-8">
									<span class="font-national text-sm font-bold uppercase tracking-widest text-[#01a2e0]">
										Featured Course
									</span>
									<h3 class="font-national text-3xl font-extrabold text-gray-800">{featured.title}</h3>
									<p class="font-national text-lg font-light text-gray-600">
										{featured.description ?? "[One-sentence course description from the item's sentence field]"}
									</p>
									<span class="mt-2 inline-flex w-fit items-center rounded-lg bg-[#0b57d0] px-6 py-3 font-national text-base font-bold text-white">
										Take the course
									</span>
								</div>

								{featured.meta && (
									<div class="flex shrink-0 flex-col border-t border-black/10 lg:w-[280px] lg:border-l lg:border-t-0">
										{[
											{ icon: "clock", label: "Length", value: featured.meta.length },
											{ icon: "tag", label: "Topic", value: featured.meta.topic },
											featured.meta.wings && { icon: "award", label: "FAA WINGS", value: featured.meta.wings },
											featured.meta.accidentForgiveness && {
												icon: "shield",
												label: "Accident Forgiveness",
												value: featured.meta.accidentForgiveness,
											},
										]
											.filter(Boolean)
											.map((row: any, idx, arr) => (
												<div
													class:list={[
														"flex items-center gap-4 px-5 py-4",
														idx < arr.length - 1 && "border-b border-black/10",
													]}
												>
													<svg
														width="22"
														height="22"
														viewBox="0 0 24 24"
														fill="none"
														stroke="#0b57d0"
														stroke-width="1.75"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="shrink-0"
														aria-hidden="true"
														set:html={ICONS[row.icon]}
													/>
													<p class="font-national text-base text-gray-600">
														{row.label}: <span class="font-bold text-gray-800">{row.value}</span>
													</p>
												</div>
											))}
									</div>
								)}
							</a>

							<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
								{rest.map((item) => (
									<a
										href="#"
										class="flex min-h-[140px] flex-col justify-between rounded-lg border border-black/10 bg-white p-6 no-underline"
									>
										<div>
											<span class="font-national text-lg font-bold text-gray-800">{item.title}</span>
											{item.meta?.length && (
												<span class="mt-1 block font-national text-base font-light text-gray-500">
													{item.meta.length}
												</span>
											)}
										</div>
										<span class="font-national text-base font-bold text-[#0b57d0]">
											{item.linkLabel ?? "Start course →"}
										</span>
									</a>
								))}
							</div>
						</>
					) : group.type === "accident" ? (
						<div class="flex flex-col gap-4">
							{group.items.map((item) => (
								<a
									href="#"
									class="flex flex-col overflow-hidden rounded-lg border border-black/10 bg-white no-underline sm:flex-row sm:items-stretch"
								>
									<div class="flex items-center gap-4 p-5 sm:w-[34%]">
										<div class="relative flex h-16 w-28 shrink-0 items-center justify-center rounded bg-gray-200">
											<span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/90 shadow-sm">
												<svg width="10" height="12" viewBox="0 0 16 18" fill="none" aria-hidden="true">
													<path d="M0 0L16 9L0 18V0Z" fill="#182f56" />
												</svg>
											</span>
										</div>
										<span class="font-national text-lg font-bold text-gray-800">{item.title}</span>
									</div>

									{item.meta && (
										<div class="grid flex-1 grid-cols-1 border-t border-black/10 sm:grid-cols-2 sm:border-l sm:border-t-0">
											{[
												{ icon: "clock", label: "Length", value: item.meta.length },
												{ icon: "tag", label: "Topic", value: item.meta.topic },
												item.meta.wings && { icon: "award", label: "FAA WINGS", value: item.meta.wings },
												item.meta.accidentForgiveness && {
													icon: "shield",
													label: "Accident Forgiveness",
													value: item.meta.accidentForgiveness,
												},
											]
												.filter(Boolean)
												.map((row: any) => (
													<div class="flex items-center gap-3 border-b border-black/10 p-4 [&:nth-child(2n)]:sm:border-l [&:nth-last-child(-n+2)]:border-b-0">
														<svg
															width="20"
															height="20"
															viewBox="0 0 24 24"
															fill="none"
															stroke="#0b57d0"
															stroke-width="1.75"
															stroke-linecap="round"
															stroke-linejoin="round"
															class="shrink-0"
															aria-hidden="true"
															set:html={ICONS[row.icon]}
														/>
														<p class="font-national text-sm text-gray-600 sm:text-base">
															{row.label}: <span class="font-bold text-gray-800">{row.value}</span>
														</p>
													</div>
												))}
										</div>
									)}
								</a>
							))}
						</div>
					) : group.type === "videos" ? (
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{group.items.map((item) => (
								<a
									href="#"
									class="flex flex-col overflow-hidden rounded-lg border border-black/5 bg-white no-underline"
								>
									<div class="relative flex aspect-video items-center justify-center bg-gray-200">
										<span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 shadow-sm">
											<svg width="16" height="18" viewBox="0 0 16 18" fill="none" aria-hidden="true">
												<path d="M0 0L16 9L0 18V0Z" fill="#182f56" />
											</svg>
										</span>
									</div>
									<div class="p-5">
										<span class="font-national text-lg font-medium text-gray-800">{item.title}</span>
									</div>
								</a>
							))}
						</div>
					) : (
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{group.items.map((item) => (
								<a
									href="#"
									class="flex items-center justify-between gap-3 rounded-lg border border-black/5 bg-white p-5 no-underline"
								>
									<span class="font-national text-lg font-medium text-gray-800">{item.title}</span>
									<span class="shrink-0 font-national text-lg font-bold text-[#01a2e0]">
										{item.linkLabel ?? "→"}
									</span>
								</a>
							))}
						</div>
					)}
				</div>
			</section>

			{group.label === "Safety Quizzes" && (
				<section class="relative overflow-hidden bg-[#182f56] px-8 py-16 sm:px-12 lg:px-24">
					<div class="mx-auto flex max-w-7xl flex-col items-center gap-10 lg:flex-row">
						<div class="flex h-56 w-44 shrink-0 items-center justify-center rounded bg-white/10 lg:h-64 lg:w-48">
							<span class="font-national text-sm font-light text-white/40">[Promo image]</span>
						</div>
						<div class="flex-1 text-center lg:text-left">
							<span class="font-national text-sm font-bold uppercase tracking-widest text-[#7ce0ff]">
								[Eyebrow]
							</span>
							<h2 class="mt-3 font-national text-3xl font-extrabold text-white sm:text-4xl">[Promo headline]</h2>
							<p class="mx-auto mt-4 max-w-[60ch] font-national text-lg font-light leading-relaxed text-white/80 lg:mx-0">
								[Promo body copy goes here — one or two sentences describing the offer and what the
								reader gets by clicking through.]
							</p>
							<a
								href="#"
								class="mt-6 inline-flex items-center rounded-lg bg-[#0b57d0] px-8 py-3 font-national text-base font-bold text-white no-underline"
							>
								[CTA label]
							</a>
						</div>
					</div>
				</section>
			)}
			</>
		);
	})}

	<HubFooter />
</div>

<style>
	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-extrabold.woff2") format("woff2");
		font-weight: 800;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-bold.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-medium.woff2") format("woff2");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-light.woff2") format("woff2");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	.font-national {
		font-family: "National", system-ui, -apple-system, sans-serif;
		font-variant-numeric: lining-nums;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	.home {
		position: relative;
		width: 100%;
		--chrome-h: calc(100vw * 127 / 2100);
		--mini-nav-h: calc(100vw * 76 / 2100);
	}

	.home__header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		height: var(--chrome-h);
		overflow: hidden;
		transition: height 0.4s ease;
	}

	.home__header.is-scrolled {
		height: var(--mini-nav-h);
	}

	.home__chrome,
	.home__mini-nav {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: auto;
		transition: transform 0.4s ease;
	}

	.home__chrome {
		transform: translateY(0);
	}

	.home__mini-nav {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__chrome {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__mini-nav {
		transform: translateY(0);
	}

	.hub-hero {
		padding-top: var(--chrome-h);
	}
</style>

<script>
	const header = document.getElementById("home-header");
	let lastScrollY = window.scrollY;

	const updateHeaderState = () => {
		const currentScrollY = window.scrollY;

		if (currentScrollY <= 0) {
			header?.classList.remove("is-scrolled");
		} else if (currentScrollY > lastScrollY) {
			header?.classList.add("is-scrolled");
		} else if (currentScrollY < lastScrollY) {
			header?.classList.remove("is-scrolled");
		}

		lastScrollY = currentScrollY;
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });
</script>
</body>
</html>

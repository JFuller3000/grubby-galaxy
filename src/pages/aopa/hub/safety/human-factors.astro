		font-style: italic;
		font-display: swap;
	}

	.font-national {
		font-family: "National", system-ui, -apple-system, sans-serif;
		font-variant-numeric: lining-nums;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	.home {
		position: relative;
		width: 100%;
		--chrome-h: calc(100vw * 127 / 2100);
		--mini-nav-h: calc(100vw * 76 / 2100);
	}

	.home__header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		height: var(--chrome-h);
		overflow: hidden;
		transition: height 0.4s ease;
	}

	.home__header.is-scrolled {
		height: var(--mini-nav-h);
	}

	.home__chrome,
	.home__mini-nav {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: auto;
		transition: transform 0.4s ease;
	}

	.home__chrome {
		transform: translateY(0);
	}

	.home__mini-nav {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__chrome {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__mini-nav {
		transform: translateY(0);
	}

	.hub-hero {
		padding-top: var(--chrome-h);
	}

	.js-faq {
		min-height: 380px;
	}

	.js-faq-a {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.35s ease;
	}

	.js-faq-item.is-open .js-faq-a {
		grid-template-rows: 1fr;
	}

	.js-faq-a > p {
		min-height: 0;
		overflow: hidden;
	}

	.js-faq-plus {
		display: inline-block;
		transition: transform 0.25s ease;
	}

	.js-faq-item.is-open .js-faq-plus {
		transform: rotate(45deg);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const header = document.getElementById("home-header");
	let lastScrollY = window.scrollY;

	const updateHeaderState = () => {
		const currentScrollY = window.scrollY;

		if (currentScrollY <= 0) {
			header?.classList.remove("is-scrolled");
		} else if (currentScrollY > lastScrollY) {
			header?.classList.add("is-scrolled");
		} else if (currentScrollY < lastScrollY) {
			header?.classList.remove("is-scrolled");
		}

		lastScrollY = currentScrollY;
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });

	document.querySelectorAll<HTMLElement>(".js-hub-advocacy .js-reveal").forEach((el) => {
		gsap.from(el, {
			opacity: 0,
			y: 40,
			ease: "none",
			scrollTrigger: {
				trigger: el,
				start: "top 85%",
				end: "top 55%",
				scrub: 1,
			},
		});
	});

	[
		[".js-hub-advocacy", ".js-hub-advocacy-bg"],
	].forEach(([sectionSelector, bgSelector]) => {
		const section = document.querySelector<HTMLElement>(sectionSelector);
		const bg = section?.querySelector<HTMLElement>(bgSelector);
		if (!section || !bg) return;

		gsap.fromTo(
			bg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: section,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	});

	document.querySelectorAll<HTMLElement>(".js-faq-q").forEach((btn) => {
		btn.addEventListener("click", () => {
			const item = btn.closest<HTMLElement>(".js-faq-item")!;
			const wasOpen = item.classList.contains("is-open");
			item.parentElement?.querySelectorAll<HTMLElement>(".js-faq-item").forEach((i) => i.classList.remove("is-open"));
			if (!wasOpen) item.classList.add("is-open");
		});
	});

	window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
</body>
</html>

<style>
	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-bold.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-bold-italic.woff2") format("woff2");
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-regular-italic.woff2") format("woff2");
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-medium.woff2") format("woff2");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-medium-italic.woff2") format("woff2");
		font-weight: 500;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-light.woff2") format("woff2");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National";
		src: url("/fonts/test-national-light-italic.woff2") format("woff2");
		font-weight: 300;
		font-style: italic;
		font-display: swap;
	}

	.font-national {
		font-family: "National", system-ui, -apple-system, sans-serif;
		font-variant-numeric: lining-nums;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	.home {
		position: relative;
		width: 100%;
		--chrome-h: calc(100vw * 127 / 2100);
		--mini-nav-h: calc(100vw * 76 / 2100);
	}

	.home__header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		height: var(--chrome-h);
		overflow: hidden;
		transition: height 0.4s ease;
	}

	.home__header.is-scrolled {
		height: var(--mini-nav-h);
	}

	.home__chrome,
	.home__mini-nav {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: auto;
		transition: transform 0.4s ease;
	}

	.home__chrome {
		transform: translateY(0);
	}

	.home__mini-nav {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__chrome {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__mini-nav {
		transform: translateY(0);
	}

	.hub-hero {
		padding-top: var(--chrome-h);
	}

	.js-faq-a {
		max-height: 0;
		transition: max-height 0.35s ease;
	}

	.js-faq-item.is-open .js-faq-a {
		max-height: 240px;
	}

	.js-faq-plus {
		display: inline-block;
		transition: transform 0.25s ease;
	}

	.js-faq-item.is-open .js-faq-plus {
		transform: rotate(45deg);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const header = document.getElementById("home-header");
	let lastScrollY = window.scrollY;

	const updateHeaderState = () => {
		const currentScrollY = window.scrollY;

		if (currentScrollY <= 0) {
			header?.classList.remove("is-scrolled");
		} else if (currentScrollY > lastScrollY) {
			header?.classList.add("is-scrolled");
		} else if (currentScrollY < lastScrollY) {
			header?.classList.remove("is-scrolled");
		}

		lastScrollY = currentScrollY;
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });

	class FlairOnlyButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-flair-btn-flair")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);
				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-flair-btn").forEach((button) => new FlairOnlyButton(button));

	document.querySelectorAll<HTMLElement>(".js-reveal").forEach((el) => {
		gsap.from(el, {
			opacity: 0,
			y: 40,
			ease: "none",
			scrollTrigger: {
				trigger: el,
				start: "top 85%",
				end: "top 55%",
				scrub: 1,
			},
		});
	});

	const hubHero = document.querySelector<HTMLElement>(".js-hub-hero");
	const hubHeroBg = hubHero?.querySelector<HTMLElement>(".js-hub-hero-bg");

	if (hubHero && hubHeroBg) {
		gsap.fromTo(
			hubHeroBg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: hubHero,
					start: "top top",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	[
		[".js-tool-module", ".js-tool-module-bg"],
		[".js-hub-advocacy", ".js-hub-advocacy-bg"],
		[".js-cross-link", ".js-cross-link-bg"],
		[".js-basicmed-frame", ".js-basicmed-bg"],
	].forEach(([sectionSelector, bgSelector]) => {
		const section = document.querySelector<HTMLElement>(sectionSelector);
		const bg = section?.querySelector<HTMLElement>(bgSelector);
		if (!section || !bg) return;

		gsap.fromTo(
			bg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: section,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	});

	const flightline = document.querySelector<SVGElement>(".js-flightline");
	const flightlinePath = flightline?.querySelector<SVGPathElement>(".js-flightline-path");
	const flightlineNodes = flightline?.querySelectorAll<SVGElement>(".js-flightline-node");
	const flightlineText = flightline?.querySelectorAll<SVGElement>(".js-flightline-text");

	if (flightline && flightlinePath) {
		const length = flightlinePath.getTotalLength();
		gsap.set(flightlinePath, { strokeDasharray: length, strokeDashoffset: length });

		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: flightline,
				start: "top 75%",
				end: "top 30%",
				scrub: 1,
			},
		});

		tl.to(flightlinePath, { strokeDashoffset: 0, ease: "none" });
		if (flightlineNodes?.length) {
			tl.to(flightlineNodes, { opacity: 1, ease: "none" }, "-=0.3");
		}
		if (flightlineText?.length) {
			tl.to(flightlineText, { opacity: 0.8, ease: "none" }, "-=0.2");
		}
	}

	const hubAdvocacy = document.querySelector<HTMLElement>(".js-hub-advocacy");
	const hubHorizon = hubAdvocacy?.querySelector<SVGGElement>(".js-hub-horizon");

	if (hubAdvocacy && hubHorizon) {
		gsap.set(hubHorizon, { svgOrigin: "52 52" });
		gsap.fromTo(
			hubHorizon,
			{ rotation: -14 },
			{
				rotation: 0,
				ease: "none",
				scrollTrigger: {
					trigger: hubAdvocacy,
					start: "top 70%",
					end: "top 30%",
					scrub: 1,
				},
			},
		);
	}

	document.querySelectorAll<HTMLElement>(".js-faq-q").forEach((btn) => {
		btn.addEventListener("click", () => {
			const item = btn.closest<HTMLElement>(".js-faq-item")!;
			const wasOpen = item.classList.contains("is-open");
			item.parentElement?.querySelectorAll<HTMLElement>(".js-faq-item").forEach((i) => i.classList.remove("is-open"));
			if (!wasOpen) item.classList.add("is-open");
		});
	});

	window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
</body>
</html>

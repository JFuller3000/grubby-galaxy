	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	.home {
		position: relative;
		width: 100%;
		--chrome-h: calc(100vw * 127 / 2100);
		--mini-nav-h: calc(100vw * 76 / 2100);
	}

	.home__header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		height: var(--chrome-h);
		overflow: hidden;
		transition: height 0.4s ease;
	}

	.home__header.is-scrolled {
		height: var(--mini-nav-h);
	}

	.home__chrome,
	.home__mini-nav {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: auto;
		transition: transform 0.4s ease;
	}

	.home__chrome {
		transform: translateY(0);
	}

	.home__mini-nav {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__chrome {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__mini-nav {
		transform: translateY(0);
	}

	.home__hero {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		box-sizing: border-box;	
		background: #fff;
		overflow: hidden;
	}

	.home__hero-inner {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.home__hero-spacer {
		height: 100vh;
		height: 100dvh;
	}

	.home__hero-bg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home__advocacy-spacer {
		height: 150vh;
		height: 150dvh;
	}

	.home__advocacy {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}

	.home__advocacy.is-active {
		display: block;
	}

	.home__flyin-spacer {
		height: 150vh;
		height: 150dvh;
	}

	.home__flyin {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}

	.home__flyin.is-active {
		display: block;
	}

	.js-spotlight-btn {
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.js-spotlight-btn::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.25s ease;
		background: radial-gradient(
			circle 60px at var(--spot-x, 50%) var(--spot-y, 50%),
			rgba(255, 255, 255, 0.25),
			transparent 70%
		);
	}

	.js-spotlight-btn:hover::before {
		opacity: 1;
	}

</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	class FlairButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly icon: HTMLElement;
		private readonly arrow: SVGElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;
		private arrowRotation = 45;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-learn-more-4-flair")!;
			this.icon = button.querySelector<HTMLElement>(".js-learn-more-4-icon")!;
			this.arrow = button.querySelector<SVGElement>(".js-learn-more-4-arrow")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			gsap.set(this.arrow, { rotation: this.arrowRotation, transformOrigin: "50% 50%" });
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);

				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation += 45;

				const tl = gsap.timeline();
				tl.to(this.icon, { scale: 1.15, duration: 0.25, ease: "power2.out" }, 0)
					.to(this.icon, { scale: 1, duration: 0.6, ease: "elastic.out(1, 0.35)" }, 0.25)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.6, ease: "power3.out" }, 0);
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation = 45;
				gsap.to(this.icon, { scale: 1, duration: 0.3, ease: "power2.out" });
				gsap.to(this.arrow, { rotation: this.arrowRotation, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-learn-more-4").forEach((button) => new FlairButton(button));

	document.querySelectorAll<HTMLElement>(".js-spotlight-btn").forEach((button) => {
		button.addEventListener("mousemove", (e) => {
			const rect = button.getBoundingClientRect();
			button.style.setProperty("--spot-x", `${e.clientX - rect.left}px`);
			button.style.setProperty("--spot-y", `${e.clientY - rect.top}px`);
		});
	});

	const gaSection = document.querySelector<HTMLElement>(".js-ga-section");
	const gaText = gaSection?.querySelector<HTMLElement>(".js-ga-text");
	const gaWings = gaSection?.querySelector<HTMLElement>(".js-ga-wings");

	if (gaSection && gaText) {
		gsap.to(gaText, {
			yPercent: -16,
			ease: "none",
			scrollTrigger: {
				trigger: gaSection,
				start: "top bottom",
				end: "bottom top",
				scrub: 1,
			},
		});
	}

	if (gaSection && gaWings) {
		gsap.to(gaWings, {
			yPercent: 32,
			ease: "none",
			scrollTrigger: {
				trigger: gaSection,
				start: "top bottom",
				end: "bottom top",
				scrub: 1,
			},
		});
	}

	const planeSection = document.querySelector<HTMLElement>(".js-plane-section");
	const planeParallax = planeSection?.querySelector<HTMLElement>(".js-plane-parallax");

	if (planeSection && planeParallax) {
		gsap.fromTo(
			planeParallax,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: planeSection,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	const planeText = planeSection?.querySelector<HTMLElement>(".js-plane-text");

	if (planeSection && planeText) {
		gsap.fromTo(
			planeText,
			{ y: 80, opacity: 0 },
			{
				y: 0,
				opacity: 1,
				ease: "none",
				scrollTrigger: {
					trigger: planeSection,
					start: "top 75%",
					end: "top 25%",
					scrub: 1,
				},
			},
		);
	}

	const magazineGrid = document.querySelector<HTMLElement>(".js-magazine-grid");
	const magazineCards = document.querySelectorAll<HTMLElement>(".js-magazine-card");

	if (magazineGrid && magazineCards.length) {
		gsap.from(magazineCards, {
			opacity: 0,
			y: 40,
			duration: 0.6,
			stagger: 0.2,
			scrollTrigger: {
				trigger: magazineGrid,
				start: "top 80%",
			},
		});
	}

	const testimonial4Section = document.querySelector<HTMLElement>(".js-testimonial-4-section");
	const testimonial4Text = testimonial4Section?.querySelector<HTMLElement>(".js-testimonial-4-text");

	if (testimonial4Section && testimonial4Text) {
		gsap.fromTo(
			testimonial4Text,
			{ y: 80, opacity: 0 },
			{
				y: 0,
				opacity: 1,
				ease: "none",
				scrollTrigger: {
					trigger: testimonial4Section,
					start: "top 95%",
					end: "top 55%",
					scrub: 1,
				},
			},
		);
	}

	const testimonial4Byline = testimonial4Section?.querySelector<HTMLElement>(".js-testimonial-4-byline");

	if (testimonial4Section && testimonial4Byline) {
		gsap.set(testimonial4Byline, { x: -60 });

		gsap.to(testimonial4Byline, {
			x: 0,
			opacity: 1,
			duration: 0.9,
			ease: "elastic.out(1, 0.6)",
			scrollTrigger: {
				trigger: testimonial4Section,
				start: "top 55%",
				toggleActions: "play none none reverse",
			},
		});
	}

	const toolsSection = document.querySelector<HTMLElement>(".js-tools-section");
	const toolsBg = toolsSection?.querySelector<HTMLElement>(".js-tools-bg");

	if (toolsSection && toolsBg) {
		gsap.fromTo(
			toolsBg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: toolsSection,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	const flySection = document.querySelector<HTMLElement>(".js-fly-section");
	const flyBg = flySection?.querySelector<HTMLElement>(".js-fly-bg");

	if (flySection && flyBg) {
		gsap.fromTo(
			flyBg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: flySection,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	const flyCardsGrid = document.querySelector<HTMLElement>(".js-fly-cards-grid");
	const flyCards = document.querySelectorAll<HTMLElement>(".js-fly-card");

	if (flyCardsGrid && flyCards.length) {
		gsap.from(flyCards, {
			opacity: 0,
			y: 40,
			duration: 0.6,
			stagger: 0.2,
			scrollTrigger: {
				trigger: flyCardsGrid,
				start: "top 80%",
			},
		});
	}

	class LetterReveal {
		constructor(target: HTMLElement, triggerEl: HTMLElement = target) {
			const letters = this.splitIntoLetters(target);

			gsap.set(letters, { opacity: 0.2 });

			gsap.to(letters, {
				opacity: 1,
				stagger: 0.015,
				ease: "none",
				scrollTrigger: {
					trigger: triggerEl,
					start: "top bottom",
					end: "top top",
					scrub: 1.2,
				},
			});
		}

		private splitIntoLetters(target: HTMLElement): HTMLElement[] {
			const letters: HTMLElement[] = [];
			const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT);
			const textNodes: Text[] = [];
			let node: Node | null;

			while ((node = walker.nextNode())) {
				textNodes.push(node as Text);
			}

			for (const textNode of textNodes) {
				const frag = document.createDocumentFragment();
				for (const char of textNode.textContent ?? "") {
					const span = document.createElement("span");
					span.textContent = char;
					span.style.display = "inline";
					frag.appendChild(span);
					letters.push(span);
				}
				textNode.replaceWith(frag);
			}

			return letters;
		}
	}

	document.querySelectorAll<HTMLElement>(".js-letter-reveal").forEach((el) => {
		const trigger = el.closest<HTMLElement>(".js-ga-section") ?? el;
		new LetterReveal(el, trigger);
	});

	class TextRipple {
		private readonly letters: HTMLElement[];

		constructor(target: HTMLElement) {
			this.letters = this.splitIntoLetters(target);
		}

		play() {
			gsap.killTweensOf(this.letters);
			gsap.to(this.letters, {
				y: -5,
				duration: 0.2,
				ease: "power1.inOut",
				stagger: { each: 0.03, from: "start" },
				yoyo: true,
				repeat: 1,
			});
		}

		private splitIntoLetters(target: HTMLElement): HTMLElement[] {
			const letters: HTMLElement[] = [];
			const text = target.textContent ?? "";
			target.textContent = "";

			for (const char of text) {
				const span = document.createElement("span");
				span.textContent = char === " " ? " " : char;
				span.style.display = "inline-block";
				target.appendChild(span);
				letters.push(span);
			}

			return letters;
		}
	}

	document.querySelectorAll<HTMLElement>(".js-ripple-btn").forEach((button) => {
		const textEl = button.querySelector<HTMLElement>(".js-ripple-text");
		if (!textEl) return;

		const ripple = new TextRipple(textEl);
		button.addEventListener("mouseenter", () => ripple.play());
	});

	const header = document.getElementById("home-header");
	const scrollThreshold = 40;

	const updateHeaderState = () => {
		header?.classList.toggle("is-scrolled", window.scrollY > scrollThreshold);
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });

	const advocacy = document.getElementById("advocacy-fixed");
	const advocacySpacer = document.getElementById("advocacy-spacer");

	if (advocacy && advocacySpacer && "IntersectionObserver" in window) {
		const advocacyObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					advocacy.classList.toggle("is-active", entry.isIntersecting);
				});
			},
			{ threshold: 0 },
		);
		advocacyObserver.observe(advocacySpacer);
	}

	const flyin = document.getElementById("flyin-fixed");
	const flyinSpacer = document.getElementById("flyin-spacer");

	if (flyin && flyinSpacer && "IntersectionObserver" in window) {
		const flyinObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					flyin.classList.toggle("is-active", entry.isIntersecting);
				});
			},
			{ threshold: 0 },
		);
		flyinObserver.observe(flyinSpacer);
	}

	window.addEventListener("load", () => ScrollTrigger.refresh());
</script>

</body>
</html>

	class TestimonialCarousel {
		private readonly photos: HTMLElement[];
		private readonly stories: HTMLElement[];
		private readonly dots: HTMLElement[];
		private readonly timerFill: HTMLElement | null;
		private readonly slideDuration = 9;
		private index = 0;
		private transitioning = false;
		private timer?: gsap.core.Tween;

		constructor(root: HTMLElement, photosRoot: HTMLElement) {
			this.photos = Array.from(photosRoot.querySelectorAll<HTMLElement>(".js-testimonial-photo"));
			this.stories = Array.from(root.querySelectorAll<HTMLElement>(".js-testimonial-story"));
			this.dots = Array.from(document.querySelectorAll<HTMLElement>(".js-testimonial-dot"));
			this.timerFill = document.querySelector<HTMLElement>(".js-testimonial-timer-fill");

			this.dots.forEach((dot, i) => {
				dot.classList.toggle("is-active", i === this.index);
				dot.addEventListener("click", () => this.goTo(i));
			});

			this.playTimer();
		}

		private playTimer() {
			this.timer?.kill();
			if (!this.timerFill) return;
			gsap.set(this.timerFill, { scaleX: 0 });
			this.timer = gsap.to(this.timerFill, {
				scaleX: 1,
				duration: this.slideDuration,
				ease: "none",
				onComplete: () => this.goTo((this.index + 1) % this.stories.length),
			});
		}

		private goTo(nextIndex: number) {
			if (this.transitioning || nextIndex === this.index) return;
			this.transitioning = true;
			this.timer?.kill();

			this.stories.forEach((story, i) => story.classList.toggle("is-active", i === nextIndex));
			this.dots.forEach((dot, i) => dot.classList.toggle("is-active", i === nextIndex));

			// fade the incoming photo in on top; the outgoing one stays fully
			// opaque underneath so the two never both go translucent at once.
			gsap.set(this.photos[nextIndex], { zIndex: 1 });
			gsap.to(this.photos[nextIndex], {
				opacity: 1,
				duration: 0.8,
				ease: "power1.inOut",
				onComplete: () => {
					gsap.set(this.photos[this.index], { opacity: 0, zIndex: 0 });
					gsap.set(this.photos[nextIndex], { zIndex: 0 });
					this.index = nextIndex;
					this.transitioning = false;
					this.playTimer();
				},
			});
		}
	}

	const testimonialStories = document.querySelector<HTMLElement>(".js-testimonial-stories");
	const testimonialPhotos = document.querySelector<HTMLElement>(".js-testimonial-photos");

	if (testimonialStories && testimonialPhotos) {
		new TestimonialCarousel(testimonialStories, testimonialPhotos);
	}

	const toolsSection = document.querySelector<HTMLElement>(".js-tools-section");
	const toolsBg = toolsSection?.querySelector<HTMLElement>(".js-tools-bg");

	if (toolsSection && toolsBg) {
		gsap.fromTo(
			toolsBg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: toolsSection,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	const flySection = document.querySelector<HTMLElement>(".js-fly-section");
	const flyBg = flySection?.querySelector<HTMLElement>(".js-fly-bg");

	if (flySection && flyBg) {
		gsap.fromTo(
			flyBg,
			{ yPercent: -10 },
			{
				yPercent: 10,
				ease: "none",
				scrollTrigger: {
					trigger: flySection,
					start: "top bottom",
					end: "bottom top",
					scrub: 1,
				},
			},
		);
	}

	const flyCardsGrid = document.querySelector<HTMLElement>(".js-fly-cards-grid");
	const flyCards = document.querySelectorAll<HTMLElement>(".js-fly-card");

	if (flyCardsGrid && flyCards.length) {
		gsap.from(flyCards, {
			opacity: 0,
			y: 40,
			stagger: 0.2,
			ease: "none",
			scrollTrigger: {
				trigger: flyCardsGrid,
				start: "top 80%",
				end: "top 50%",
				scrub: 1,
			},
		});
	}

	class LetterReveal {
		constructor(target: HTMLElement, triggerEl: HTMLElement = target) {
			const letters = this.splitIntoLetters(target);

			gsap.set(letters, { opacity: 0.2 });

			gsap.to(letters, {
				opacity: 1,
				stagger: 0.015,
				ease: "none",
				scrollTrigger: {
					trigger: triggerEl,
					start: "top 55%",
					end: "top 0%",
					scrub: 1.2,
				},
			});
		}

		private splitIntoLetters(target: HTMLElement): HTMLElement[] {
			const letters: HTMLElement[] = [];
			const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT);
			const textNodes: Text[] = [];
			let node: Node | null;

			while ((node = walker.nextNode())) {
				textNodes.push(node as Text);
			}

			for (const textNode of textNodes) {
				const frag = document.createDocumentFragment();
				for (const char of textNode.textContent ?? "") {
					const span = document.createElement("span");
					span.textContent = char;
					span.style.display = "inline";
					frag.appendChild(span);
					letters.push(span);
				}
				textNode.replaceWith(frag);
			}

			return letters;
		}
	}

	document.querySelectorAll<HTMLElement>(".js-letter-reveal").forEach((el) => {
		const trigger = el.closest<HTMLElement>(".js-ga-section") ?? el;
		new LetterReveal(el, trigger);
	});

	const header = document.getElementById("home-header");
	let lastScrollY = window.scrollY;

	const updateHeaderState = () => {
		const currentScrollY = window.scrollY;

		if (currentScrollY <= 0) {
			header?.classList.remove("is-scrolled");
		} else if (currentScrollY > lastScrollY) {
			header?.classList.add("is-scrolled");
		} else if (currentScrollY < lastScrollY) {
			header?.classList.remove("is-scrolled");
		}

		lastScrollY = currentScrollY;
	};

	updateHeaderState();
	window.addEventListener("scroll", updateHeaderState, { passive: true });

	const advocacy = document.getElementById("advocacy-fixed");
	const advocacySpacer = document.getElementById("advocacy-spacer");

	if (advocacy && advocacySpacer && "IntersectionObserver" in window) {
		const advocacyObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					advocacy.classList.toggle("is-active", entry.isIntersecting);
				});
			},
			{ threshold: 0 },
		);
		advocacyObserver.observe(advocacySpacer);
	}

	const flyin = document.getElementById("flyin-fixed");
	const flyinSpacer = document.getElementById("flyin-spacer");

	if (flyin && flyinSpacer && "IntersectionObserver" in window) {
		const flyinObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					flyin.classList.toggle("is-active", entry.isIntersecting);
				});
			},
			{ threshold: 0 },
		);
		flyinObserver.observe(flyinSpacer);
	}

	document.querySelectorAll<HTMLElement>(".home__advocacy, .home__flyin").forEach((fixedSection) => {
		const spacer = fixedSection.previousElementSibling as HTMLElement | null;
		const photos = fixedSection.querySelectorAll<HTMLElement>(".js-duotone-photo");
		const overlay = fixedSection.querySelector<HTMLElement>(".js-duotone-overlay");

		if (!spacer || !photos.length || !overlay) return;

		const start = fixedSection.id === "advocacy-fixed" ? "bottom+=500 bottom" : "bottom bottom";

		gsap.fromTo(
			photos,
			{ filter: "grayscale(0%)" },
			{
				filter: "grayscale(100%)",
				ease: "none",
				scrollTrigger: {
					trigger: spacer,
					start,
					end: "bottom top",
					scrub: true,
				},
			},
		);

		gsap.fromTo(
			overlay,
			{ opacity: 0 },
			{
				opacity: 0.85,
				ease: "none",
				scrollTrigger: {
					trigger: spacer,
					start,
					end: "bottom top",
					scrub: true,
				},
			},
		);
	});

	class AdvocacyCarousel {
		private readonly photos: HTMLElement[];
		private readonly stories: HTMLElement[];
		private readonly dots: HTMLElement[];
		private readonly timerFill: HTMLElement | null;
		private readonly slideDuration = 6;
		private index = 0;
		private transitioning = false;
		private timer?: gsap.core.Tween;

		constructor(root: HTMLElement, storiesRoot: HTMLElement) {
			this.photos = Array.from(root.querySelectorAll<HTMLElement>(".js-carousel-photo"));
			this.stories = Array.from(storiesRoot.querySelectorAll<HTMLElement>(".js-carousel-story"));
			this.dots = Array.from(document.querySelectorAll<HTMLElement>(".js-carousel-dot"));
			this.timerFill = document.querySelector<HTMLElement>(".js-carousel-timer-fill");

			this.dots.forEach((dot, i) => {
				dot.classList.toggle("is-active", i === this.index);
				dot.addEventListener("click", () => this.goTo(i));
			});

			this.playTimer();
		}

		private playTimer() {
			this.timer?.kill();
			if (!this.timerFill) return;
			gsap.set(this.timerFill, { scaleX: 0 });
			this.timer = gsap.to(this.timerFill, {
				scaleX: 1,
				duration: this.slideDuration,
				ease: "none",
				onComplete: () => this.goTo((this.index + 1) % this.photos.length),
			});
		}

		private goTo(nextIndex: number) {
			if (this.transitioning || nextIndex === this.index) return;
			this.transitioning = true;
			this.timer?.kill();

			// fade the incoming photo in on top; the outgoing one stays fully
			// opaque underneath so the two never both go translucent at once
			// (which would let whatever is behind the fixed section show through).
			gsap.set(this.photos[nextIndex], { zIndex: 1 });
			gsap.to(this.photos[nextIndex], {
				opacity: 1,
				duration: 0.8,
				ease: "power1.inOut",
				onComplete: () => {
					gsap.set(this.photos[this.index], { opacity: 0, zIndex: 0 });
					gsap.set(this.photos[nextIndex], { zIndex: 0 });
					this.index = nextIndex;
					this.transitioning = false;
					this.playTimer();
				},
			});

			this.stories.forEach((story, i) => {
				story.classList.toggle("is-active", i === nextIndex);
			});
			this.dots.forEach((dot, i) => {
				dot.classList.toggle("is-active", i === nextIndex);
			});
		}
	}

	const advocacyFixed = document.getElementById("advocacy-fixed");
	const advocacyStories = document.querySelector<HTMLElement>(".js-carousel-stories");

	if (advocacyFixed && advocacyStories) {
		new AdvocacyCarousel(advocacyFixed, advocacyStories);
	}

	gsap.to(".js-partners-gradient", {
		backgroundPosition: "100% 100%",
		ease: "none",
		scrollTrigger: {
			trigger: ".js-partners-gradient",
			start: "top bottom",
			end: "bottom top",
			scrub: 1,
		},
	});

	gsap.to(".js-tools-gradient", {
		backgroundPosition: "100% 100%",
		ease: "none",
		scrollTrigger: {
			trigger: ".js-tools-gradient",
			start: "top bottom",
			end: "center top",
			scrub: 1,
		},
	});

	const flyinButton = document.querySelector<HTMLElement>(".js-flyin-button");

	if (flyinButton && flyinSpacer) {
		gsap.fromTo(
			flyinButton,
			{ y: 500 },
			{
				y: 0,
				ease: "none",
				scrollTrigger: {
					trigger: flyinSpacer,
					start: "center bottom",
					end: "bottom bottom",
					scrub: true,
				},
			},
		);
	}

	window.addEventListener("load", () => ScrollTrigger.refresh());
</script>

</body>
</html>

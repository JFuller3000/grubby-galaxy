---
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>AOPA Home</title>
</head>
<body>

<div class="home">
	<header class="home__header" id="home-header">
		<img class="home__chrome" src="/images/aopa/home/1/chrome-100.jpg" alt="" />
		<img class="home__mini-nav" src="/images/aopa/home/1/mini-nav-100.jpg" alt="" />
	</header>

	<section class="home__hero">
		<div class="home__hero-inner">
			<video
				class="home__hero-bg"
				src="/images/aopa/home/CADENCE1.mov"
				poster="/images/aopa/home/video-placeholder-100.jpg"
				autoplay
				muted
				loop
				playsinline
			></video>
			<div class="pointer-events-none absolute inset-x-0 bottom-0 z-[5] h-1/2 bg-gradient-to-t from-black/70 to-transparent"></div>

			<div class="absolute inset-x-0 bottom-12 z-10 flex flex-col gap-8 px-8 sm:bottom-16 sm:px-12 lg:bottom-20 lg:flex-row lg:items-end lg:justify-around lg:gap-16 lg:px-24">
				<h1 class="font-national m-0 flex flex-col text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-8xl leading-none">
					<span class="w-fit font-normal italic text-white/90 drop-shadow-lg">Where</span>
					<span class="mt-2 w-fit pb-1 text-white drop-shadow-lg">Pilots Belong</span>
				</h1>

				<div class="max-w-lg lg:pb-2">
					<p class="text-3xl leading-relaxed text-white/90">
						Trusted tools, a nationwide community, and aviation's boldest advocates,
						<span class="italic">together in one membership.</span>
					</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a
							href="#"
							class="inline-flex items-center justify-center rounded-full bg-[#182f56] px-7 py-3.5 text-[0.95rem] font-bold text-white no-underline"
						>
							Join AOPA
						</a>
						<a
							href="#"
							class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-[0.95rem] font-bold text-[#182f56] no-underline"
						>
							Membership Options
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
	<div class="home__hero-spacer" aria-hidden="true"></div>

	<section class="js-ga-section relative z-[1] flex min-h-[100vh] items-center overflow-hidden bg-white px-8 py-20 sm:px-12 lg:px-24 lg:py-28">
		<img
			src="/images/aopa/home/4/wings-bg.svg"
			alt=""
			aria-hidden="true"
			class="js-ga-wings pointer-events-none absolute left-0 top-12 w-[52rem] max-w-none select-none will-change-transform"
		/>

		<div class="relative mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_auto] lg:items-start lg:gap-16">
			<div class="js-ga-text max-w-5xl will-change-transform">
				<h2 class="font-national text-4xl font-bold leading-tight text-[#182f56] sm:text-5xl">
					General aviation runs on a simple truth:<br />
					<span class="text-[#40b9e8]">Without AOPA, there is no GA.</span>
				</h2>
				<p class="js-letter-reveal font-national mt-8 text-3xl font-normal leading-relaxed text-gray-500">
					The Aircraft Owners and Pilots Association (AOPA) is the largest, most experienced
					pilot community in the world.
					<strong class="font-medium text-gray-700">Our 300,000 members give general aviation its
						voice.</strong>
					&nbsp;Since 1939, we have been in the rooms where the rules get made: on Capitol Hill,
					at the FAA, and in the statehouses where your right to fly is decided.
					<strong class="font-medium text-gray-700">From your first lesson to your next airplane,
						AOPA is the membership that protects your freedom to fly.</strong>
				</p>
			</div>

			<a
				href="#"
				class="js-learn-more-4 relative inline-flex items-center gap-5 self-start overflow-hidden rounded-full bg-[#182f56] py-2 pl-12 pr-2 no-underline"
			>
				<span
					class="js-learn-more-4-flair pointer-events-none absolute inset-0 origin-top-left scale-0 will-change-transform"
					aria-hidden="true"
				>
					<span class="absolute left-0 top-0 aspect-square w-[260%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#5b9bd5] opacity-40"></span>
				</span>
				<span class="js-learn-more-4-label relative text-[1.0625rem] uppercase tracking-widest text-white pr-4">
					Learn More
				</span>
				<span
					class="js-learn-more-4-icon relative grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white text-[#182f56]"
					aria-hidden="true"
				>
					<svg class="js-learn-more-4-arrow h-10 w-10 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
						<polygon
							fill="currentColor"
							points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
						/>
					</svg>
				</span>
			</a>
		</div>
	</section>

	<section class="js-fly-section relative z-[1] overflow-hidden bg-[#1d3f6d] px-8 py-16 sm:px-12 lg:px-24 lg:py-20 min-h-[70vh]">
		<img
			src="/images/aopa/home/4/sky-portrait.jpg"
			alt=""
			aria-hidden="true"
			class="js-fly-bg pointer-events-none absolute inset-x-0 -top-[15%] h-[130%] w-full select-none object-cover will-change-transform"
		/>
		<div class="pointer-events-none absolute inset-0 bg-[#1d3f6d]/80"></div>

		<div class="relative mx-auto max-w-7xl">
			<h2 class="font-national text-center text-3xl font-bold text-white sm:text-4xl">
				<span class="font-national font-normal italic">Everything</span> your kind of flying demands.
			</h2>

			<div class="js-fly-cards-grid mt-14 grid gap-4 text-center sm:grid-cols-2 lg:grid-cols-4">
				<div class="js-fly-card rounded-2xl bg-black/15 p-8">
					<svg class="mx-auto mb-6 h-14 w-14 text-white" viewBox="0 0 256 256" fill="currentColor">
						<path d="M208,40H48A16,16,0,0,0,32,56v56c0,52.72,25.52,84.67,46.93,102.19,23.06,18.86,46,25.27,47,25.53a8,8,0,0,0,4.2,0c1-.26,23.91-6.67,47-25.53C198.48,196.67,224,164.72,224,112V56A16,16,0,0,0,208,40Zm0,72c0,37.07-13.66,67.16-40.6,89.42A129.3,129.3,0,0,1,128,223.62a128.25,128.25,0,0,1-38.92-21.81C61.82,179.51,48,149.3,48,112l0-56,160,0Z" />
					</svg>
					<h3 class="font-national text-lg font-bold text-[#5b9bd5]">General Aviation Advocacy</h3>
					<p class="mt-3 text-white/85">See what we're doing to protect your rights</p>
					<a href="#" class="js-spotlight-btn relative isolate mt-6 inline-block overflow-hidden rounded bg-[#01a2e0] px-5 py-3 font-national font-bold uppercase tracking-wide text-white no-underline">
						<span class="relative z-10">Advocacy</span>
					</a>
				</div>

				<div class="js-fly-card rounded-2xl bg-black/15 p-8">
					<svg class="mx-auto mb-6 h-14 w-14 text-white" viewBox="0 0 256 256" fill="currentColor">
						<path d="M220,160a12,12,0,1,1-12-12A12,12,0,0,1,220,160Zm-4.55,39.29A48.08,48.08,0,0,1,168,240H144a48.05,48.05,0,0,1-48-48V151.49A64,64,0,0,1,40,88V40a8,8,0,0,1,8-8H72a8,8,0,0,1,0,16H56V88a48,48,0,0,0,48.64,48c26.11-.34,47.36-22.25,47.36-48.83V48H136a8,8,0,0,1,0-16h24a8,8,0,0,1,8,8V87.17c0,32.84-24.53,60.29-56,64.31V192a32,32,0,0,0,32,32h24a32.06,32.06,0,0,0,31.22-25,40,40,0,1,1,16.23.27ZM232,160a24,24,0,1,0-24,24A24,24,0,0,0,232,160Z" />
					</svg>
					<h3 class="font-national text-lg font-bold text-[#5b9bd5]">
						Legal &amp; Medical Support
					</h3>
					<p class="mt-3  text-white/85">
						Add Pilot Protection Services so you never face the FAA alone.
					</p>
					<a href="#" class="js-spotlight-btn relative isolate mt-6 inline-block overflow-hidden rounded bg-[#01a2e0] px-5 py-3 font-national font-bold uppercase tracking-wide text-white no-underline">
						<span class="relative z-10">Pilot Protection Services</span>
					</a>
				</div>

				<div class="js-fly-card rounded-2xl bg-black/15 p-8">
					<svg class="mx-auto mb-6 h-14 w-14 text-white" viewBox="0 0 256 256" fill="currentColor">
						<path d="M140,180a12,12,0,1,1-12-12A12,12,0,0,1,140,180ZM128,72c-22.06,0-40,16.15-40,36v4a8,8,0,0,0,16,0v-4c0-11,10.77-20,24-20s24,9,24,20-10.77,20-24,20a8,8,0,0,0-8,8v8a8,8,0,0,0,16,0v-.72c18.24-3.35,32-17.9,32-35.28C168,88.15,150.06,72,128,72Zm104,56A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z" />
					</svg>
					<h3 class="font-national text-lg font-bold text-[#5b9bd5]">Aviation Questions, Answered</h3>
					<p class="mt-3  text-white/85">
						No bots here. Get live responses from pilots, CFIs, mechanics, and more.
					</p>
					<a href="#" class="js-spotlight-btn relative isolate mt-6 inline-block overflow-hidden rounded bg-[#01a2e0] px-5 py-3 font-national font-bold uppercase tracking-wide text-white no-underline">
						<span class="relative z-10">Pilot Tools</span>
					</a>
				</div>

				<div class="js-fly-card rounded-2xl bg-black/15 p-8">
					<svg class="mx-auto mb-6 h-14 w-14 text-white" viewBox="0 0 256 256" fill="currentColor">
						<path d="M251.76,88.94l-120-64a8,8,0,0,0-7.52,0l-120,64a8,8,0,0,0,0,14.12L32,117.87v48.42a15.91,15.91,0,0,0,4.06,10.65C49.16,191.53,78.51,216,128,216a130,130,0,0,0,48-8.76V240a8,8,0,0,0,16,0V199.51a115.63,115.63,0,0,0,27.94-22.57A15.91,15.91,0,0,0,224,166.29V117.87l27.76-14.81a8,8,0,0,0,0-14.12ZM128,200c-43.27,0-68.72-21.14-80-33.71V126.4l76.24,40.66a8,8,0,0,0,7.52,0L176,143.47v46.34C163.4,195.69,147.52,200,128,200Zm80-33.75a97.83,97.83,0,0,1-16,14.25V134.93l16-8.53ZM188,118.94l-.22-.13-56-29.87a8,8,0,0,0-7.52,14.12L171,128l-43,22.93L25,96,128,41.07,231,96Z" />
					</svg>
					<h3 class="font-national text-lg font-bold text-[#5b9bd5]">
						Training &amp; Scholarships
					</h3>
					<p class="mt-3 text-white/85">Learn to fly, add a rating, or get back in the left seat.</p>
					<a href="#" class="js-spotlight-btn relative isolate mt-6 inline-block overflow-hidden rounded bg-[#01a2e0] px-5 py-3 font-national font-bold uppercase tracking-wide text-white no-underline">
						<span class="relative z-10">Learn to Fly</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<div class="home__advocacy-spacer relative" id="advocacy-spacer">
		<div class="absolute right-6 top-[20vh] z-[1] h-[210vh] sm:right-10">
			<a
				href="#"
				class="sticky top-24 inline-flex items-center gap-4 rounded-full bg-white py-2 pl-8 pr-2 no-underline shadow-lg"
			>
				<span class="font-national text-sm font-bold uppercase tracking-widest text-[#182f56]">
					See What We're Fighting For
				</span>
				<span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#01a2e0] text-white">
					<svg class="h-6 w-6 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
						<polygon
							fill="currentColor"
							points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
						/>
					</svg>
				</span>
			</a>
		</div>

		<div class="absolute left-6 top-[40vh] z-[1] h-[260vh] sm:left-16 lg:left-24">
			<div class="sticky top-[50vh] flex max-w-6xl flex-wrap gap-x-10 gap-y-4 bg-[#f2f2f2]/90 p-20">
				<div class="shrink-0 text-4xl">
					<p class="font-national italic  italic leading-none text-[#182f56]">Advocacy</p>
					<p class="font-national  font-bold leading-none text-[#182f56]">in Action</p>
				</div>
				<div class="max-w-sm">
					<h3 class="font-national text-2xl font-bold text-[#182f56]">Prioritizing Unleaded Avgas</h3>
					<p class="mt-3 font-national italic leading-relaxed text-gray-500 text-xl">
						AOPA is working with the FAA and industry to provide a clear, safe path to a single
						high-octane unleaded avgas, to ensure the industry's transition to unleaded fuel.
					</p>
					<a
						href="#"
						class="font-national mt-4 inline-flex items-center gap-2 text-lg font-bold uppercase tracking-wide text-[#01a2e0] no-underline"
					>
						Read More
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="home__advocacy" id="advocacy-fixed">
		<img
			src="/images/aopa/home/4/advocacy-gas-100.jpg"
			alt=""
			aria-hidden="true"
			class="js-advocacy-bg absolute inset-0 h-full w-full select-none object-cover will-change-transform"
		/>

		<div class="absolute bottom-6 left-1/2 z-[1] flex -translate-x-1/2 gap-2">
			<span class="h-2.5 w-2.5 rounded-full bg-[#182f56]"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-white/60"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-white/60"></span>
		</div>
	</div>

	<section class="js-plane-section relative z-[1] overflow-hidden bg-white px-8 py-20 sm:px-12 lg:px-24">
		<h2 class="mx-auto max-w-5xl text-center font-national text-2xl leading-snug text-[#182f56] sm:text-4xl">
			<span class="font-normal italic">You didn't fall in love with flying</span>
			<span class="font-bold">because it was practical.</span>
		</h2>

		<div class="relative mx-auto mt-14 grid max-w-7xl gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
			<div class="relative aspect-[4/5] w-full overflow-hidden">
				<img
					src="/images/aopa/home/4/plane-clouds-100.jpg"
					alt=""
					class="js-plane-parallax absolute inset-x-0 -top-[18%] h-[136%] w-full select-none object-cover will-change-transform"
				/>
			</div>

			<div class="js-plane-text will-change-transform">
				<p class="font-national text-2xl italic leading-relaxed text-gray-500">
					You fly for the freedom, independence, and adventure you can't experience anywhere
					else. AOPA exists to protect that for you and the next generation.
				</p>
				<p class="mt-6 font-national text-lg leading-relaxed text-gray-600">
					We're on the phone when you have an aviation question, and on your side the day
					something goes wrong. Our basic membership starts at $89 a year and puts real people
					in your corner:
				</p>

				<ul class="mt-8 space-y-4">
					<li class="flex items-start gap-3">
						<span class="mt-1.5 h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
						<span class="font-national font-bold text-[#182f56]">A team of advocates protecting your right to fly</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1.5 h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
						<span class="font-national font-bold text-[#182f56]">A helpline answered by actual pilots, mechanics, and CFIs</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1.5 h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
						<span class="font-national font-bold text-[#182f56]">Safety education and training</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1.5 h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
						<span class="font-national font-bold text-[#182f56]">Flight planning and weather tools</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1.5 h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
						<span class="font-national font-bold text-[#182f56]">Exclusive discounts</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1.5 h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
						<span class="font-national font-bold text-[#182f56]">Award-winning magazines delivered to your door</span>
					</li>
				</ul>

				<div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-4">
					<a
						href="#"
						class="js-learn-more-4 relative inline-flex items-center gap-5 overflow-hidden rounded-full bg-[#182f56] py-2 pl-8 pr-2 no-underline"
					>
						<span
							class="js-learn-more-4-flair pointer-events-none absolute inset-0 origin-top-left scale-0 will-change-transform"
							aria-hidden="true"
						>
							<span class="absolute left-0 top-0 aspect-square w-[260%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#5b9bd5] opacity-40"></span>
						</span>
						<span class="js-learn-more-4-label relative font-national text-sm uppercase tracking-widest text-white">
							Join Now
						</span>
						<span
							class="js-learn-more-4-icon relative grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-[#182f56]"
							aria-hidden="true"
						>
							<svg class="js-learn-more-4-arrow h-8 w-8 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
								<polygon
									fill="currentColor"
									points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
								/>
							</svg>
						</span>
					</a>

					<div class="flex flex-col gap-2">
						<a href="#" class="font-national font-bold text-[#182f56] underline underline-offset-4">
							Compare Membership Levels
						</a>
						<a href="#" class="font-national font-bold text-[#182f56] underline underline-offset-4">
							Add Legal &amp; Medical Support
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="js-tools-section relative z-[1] overflow-hidden bg-[#1d3f6d] px-8 py-24 sm:px-12 lg:px-16">
		<img
			src="/images/aopa/home/4/sky-portrait.jpg"
			alt=""
			aria-hidden="true"
			class="js-tools-bg pointer-events-none absolute inset-x-0 -top-[15%] h-[130%] w-full select-none object-cover will-change-transform"
		/>
		<div class="pointer-events-none absolute inset-0 bg-[#1d3f6d]/80"></div>

		<div class="relative mx-auto grid max-w-7xl gap-24 lg:grid-cols-2">
			<div class="relative overflow-hidden rounded-t-lg rounded-bl-[7rem] bg-white">
				<div class="h-2 w-full bg-[#182f56]"></div>
				<div class="px-8 py-10 sm:px-10">
					<h3 class="font-national text-3xl leading-tight text-[#182f56]">
						<span class="font-normal italic">Free tools</span><br />
						<span class="font-bold">To plan your next flight</span>
					</h3>
					<p class="mt-6 font-national text-gray-600">
						Look up an airport, check the weather, and plan your next trip.
					</p>

					<div class="mt-8 flex overflow-hidden rounded-full">
						<input
							type="text"
							placeholder="Enter Airport Identifier or City"
							class="min-w-0 flex-1 bg-gray-100 px-6 py-4 font-national text-sm text-[#182f56] placeholder:text-gray-500 focus:outline-none"
						/>
						<button
							type="button"
							class="shrink-0 bg-[#182f56] px-8 py-4 font-national text-sm font-bold uppercase tracking-wide text-white"
						>
							Look Up
						</button>
					</div>

					<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
						<a href="#" class="flex items-center gap-3 border border-gray-200 px-5 py-4 font-national text-sm font-bold text-[#182f56] no-underline">
							<span class="h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
							Fuel Prices
						</a>
						<a href="#" class="flex items-center gap-3 border border-gray-200 px-5 py-4 font-national text-sm font-bold text-[#182f56] no-underline">
							<span class="h-2.5 w-2.5 shrink-0 bg-[#01a2e0]"></span>
							Flying Clubs
						</a>

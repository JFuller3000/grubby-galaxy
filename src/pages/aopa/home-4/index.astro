	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	.home {
		position: relative;
		width: 100%;
		--chrome-h: calc(100vw * 127 / 2100);
		--mini-nav-h: calc(100vw * 76 / 2100);
	}

	.home__header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		height: var(--chrome-h);
		overflow: hidden;
		transition: height 0.4s ease;
	}

	.home__header.is-scrolled {
		height: var(--mini-nav-h);
	}

	.home__chrome,
	.home__mini-nav {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: auto;
		transition: transform 0.4s ease;
	}

	.home__chrome {
		transform: translateY(0);
	}

	.home__mini-nav {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__chrome {
		transform: translateY(-100%);
	}

	.home__header.is-scrolled .home__mini-nav {
		transform: translateY(0);
	}

	.home__hero {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		box-sizing: border-box;	
		background: #fff;
		overflow: hidden;
	}

	.home__hero-inner {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.home__hero-spacer {
		height: 100vh;
		height: 100dvh;
	}

	.home__hero-bg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home__advocacy-spacer {
		height: 150vh;
		height: 150dvh;
	}

	.home__advocacy {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}

	.home__advocacy.is-active {
		display: block;
	}

	.home__flyin-spacer {
		height: 150vh;
		height: 150dvh;
	}

	.home__flyin {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}

	.home__flyin.is-active {
		display: block;
	}

	.js-cube {
		perspective: 1600px;
	}

	.js-cube-inner {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.js-cube:hover .js-cube-inner {
		transform: rotateY(-90deg);
	}

	.js-cube-face {
		position: absolute;
		inset: 0;
		overflow: hidden;
		backface-visibility: hidden;
	}

	.js-cube-face--front {
		transform: translateZ(var(--cube-depth, 160px));
	}

	.js-cube-face--side {
		transform: rotateY(90deg) translateZ(var(--cube-depth, 160px));
	}

	.js-duotone-overlay {
		background: #017fae;
		mix-blend-mode: color;
		opacity: 0;
	}

	.js-carousel-story {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.8s ease;
	}

	.js-carousel-story.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.js-carousel-dot {
		transition: background-color 0.3s ease;
	}

	.js-carousel-dot.is-active {
		background-color: #182f56;
	}

	.js-testimonial-story {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.8s ease;
	}

	.js-testimonial-story.is-active {
		opacity: 1;
		pointer-events: auto;

</style>

<script>
	const intro = document.getElementById("fdn-intro");
	const words = document.querySelectorAll<HTMLElement>(".fdn-intro__word");
	const video = document.getElementById("fdn-video") as HTMLVideoElement;

	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const wordStagger = 220;
	const postTypeDelay = 1000;
	const wordTransitionDuration = 450;
	const videoPlaybackDuration = 5000;

	const revealWord = (index: number) => {
		words[index]?.classList.add("is-visible");
	};

	const hideIntro = () => {
		intro?.classList.add("is-hidden");
		video?.play().catch(() => {
			/* autoplay can be blocked; the video simply stays paused on first frame */
		});
		setTimeout(hideVideo, videoPlaybackDuration);
	};

	const unlockScroll = () => {
		document.documentElement.classList.remove("fdn-scroll-lock");
		document.dispatchEvent(new Event("fdn:intro-complete"));
	};

	const hideVideo = () => {
		video?.classList.add("is-hidden");
	};

	video?.addEventListener("transitionend", (event) => {
		if (event.propertyName === "opacity" && video.classList.contains("is-hidden")) {
			unlockScroll();
		}
	});

	if (prefersReducedMotion) {
		words.forEach((word) => word.classList.add("is-visible"));
		intro?.classList.add("is-hidden");
		video?.classList.add("is-hidden");
		unlockScroll();
	} else {
		words.forEach((_, index) => {
			setTimeout(() => revealWord(index), index * wordStagger);
		});

		const typingDuration = (words.length - 1) * wordStagger + wordTransitionDuration;
		setTimeout(hideIntro, typingDuration + postTypeDelay);

		video?.addEventListener("ended", hideVideo);
	}
</script>

<script>
	const countEls = document.querySelectorAll<HTMLElement>(".fdn-impact__value[data-count-to]");
	const prefersReducedMotionForCounts = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const countDuration = 1400;

	const formatCount = (value: number, suffix: string) =>
		`${Math.round(value).toLocaleString("en-US")}${suffix}`;

	const animateCount = (el: HTMLElement) => {
		const target = Number(el.dataset.countTo ?? "0");
		const suffix = el.dataset.countSuffix ?? "";
		const start = performance.now();

		const step = (now: number) => {
			const progress = Math.min(1, (now - start) / countDuration);
			const eased = 1 - Math.pow(1 - progress, 3);
			el.textContent = formatCount(target * eased, suffix);
			if (progress < 1) requestAnimationFrame(step);
			else el.textContent = formatCount(target, suffix);
		};

		requestAnimationFrame(step);
	};

	if (prefersReducedMotionForCounts || !("IntersectionObserver" in window)) {
		countEls.forEach((el) => {
			const target = Number(el.dataset.countTo ?? "0");
			el.textContent = formatCount(target, el.dataset.countSuffix ?? "");
		});
	} else {
		countEls.forEach((el) => {
			el.textContent = formatCount(0, el.dataset.countSuffix ?? "");
		});

		const countObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						animateCount(entry.target as HTMLElement);
						countObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.4 },
		);

		countEls.forEach((el) => countObserver.observe(el));
	}
</script>

<script>
	const heroSlideEls = document.querySelectorAll<HTMLElement>(".fdn-hero-slide");
	const heroTimerBar = document.getElementById("fdn-hero-timer-bar");
	const heroSlideDuration = 8000;
	let currentHeroSlide = 0;

	const prefersReducedMotionForSlides = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const showHeroSlide = (index: number) => {
		heroSlideEls.forEach((slide, i) => slide.classList.toggle("is-active", i === index));
	};

	const runHeroTimerBar = () => {
		if (!heroTimerBar) return;
		heroTimerBar.style.transition = "none";
		heroTimerBar.style.width = "0%";
		void heroTimerBar.offsetWidth;
		heroTimerBar.style.transition = `width ${heroSlideDuration}ms linear`;
		heroTimerBar.style.width = "100%";
	};

	const advanceHeroSlide = () => {
		currentHeroSlide = (currentHeroSlide + 1) % heroSlideEls.length;
		showHeroSlide(currentHeroSlide);
		runHeroTimerBar();
	};

	const startHeroSlideshow = () => {
		runHeroTimerBar();
		setInterval(advanceHeroSlide, heroSlideDuration);
	};

	if (heroSlideEls.length > 1 && !prefersReducedMotionForSlides) {
		document.addEventListener("fdn:intro-complete", startHeroSlideshow, { once: true });
	} else if (heroTimerBar) {
		heroTimerBar.parentElement?.style.setProperty("display", "none");
	}
</script>


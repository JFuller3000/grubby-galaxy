---
const introWords = "Building a Stronger Safer Pilot Community".split(" ");

const navLinks = ["Programs", "Ways To Give"];
const navLinksSecondary = ["About", "Contact Us"];
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>AOPA Foundation</title>
</head>
<body>

<div class="fdn-shell">
	<header class="fdn-nav">
		<div class="fdn-nav__brand-row">
			<a href="/aopa/foundation" class="fdn-nav__brand">
				<img
					class="fdn-nav__brand-mark"
					src="/images/aopa-wings-logo-blue.svg"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span class="fdn-nav__brand-word">AOPA Foundation</span>
			</a>
		</div>
		<hr class="fdn-nav__rule" />
		<nav class="fdn-nav__links" aria-label="Foundation navigation">
			{navLinks.map((label) => (
				<a href="#" class="fdn-nav__link">{label}</a>
			))}
			<span class="fdn-nav__spacer" aria-hidden="true"></span>
			{navLinksSecondary.map((label) => (
				<a href="#" class="fdn-nav__link">{label}</a>
			))}
			<a href="#" class="fdn-nav__donate">Donate Today</a>
		</nav>
	</header>

	<section class="fdn-page">
		<img class="fdn-page__image" src="/images/foundation/03-295_085.jpg" alt="" />

		<div class="fdn-hero-copy">
			<h1 class="fdn-hero-copy__title">AOPA<br />Foundation</h1>
			<p class="fdn-hero-copy__kicker">The Philanthropic Arm of AOPA</p>
			<p class="fdn-hero-copy__body">
				Your contributions fund programs that membership dues don’t cover, including the AOPA Air Safety Institute and You Can Fly program. Our goal is to fund opportunities of growth for every AOPA member and the entire general aviation community. 
			</p>
		</div>

		<dl class="fdn-hero-stats">
			<div class="fdn-hero-stats__item">
				<dt class="fdn-hero-stats__value">5K</dt>
				<dd class="fdn-hero-stats__label">Lorem<br />Ipsums</dd>
			</div>
			<div class="fdn-hero-stats__item">
				<dt class="fdn-hero-stats__value">32</dt>
				<dd class="fdn-hero-stats__label">Dolorum<br />Estis</dd>
			</div>
			<div class="fdn-hero-stats__item">
				<dt class="fdn-hero-stats__value">231</dt>
				<dd class="fdn-hero-stats__label">Amet<br />Consectus</dd>
			</div>
		</dl>
	</section>
</div>

<section class="fdn-programs">
	<div class="fdn-programs__text">
		<h2 class="fdn-programs__title">AOPA Foundation Programs</h2>
		<p class="fdn-programs__body">
			This isn't just about getting people interested in aviation; it's about giving them a way
			in. AOPA Foundation Aviation Programs connect students, educators, and pilots with real
			opportunities to learn, grow, and take action. Built on experience and driven by impact,
			these initiatives open doors at every stage of the aviation journey.
		</p>
		<a href="#" class="fdn-programs__link">
			Read More
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 12h13M13 6l7 6-7 6"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</a>
	</div>
	<div class="fdn-programs__media">
		<img
			class="fdn-programs__image"
			src="/images/foundation/11r-367_036.jpg"
			alt=""
			loading="lazy"
			decoding="async"
		/>
	</div>
</section>

<video
	class="fdn-video"
	id="fdn-video"
	src="/images/foundation/hero-video-desktop-3.mp4"
	muted
	playsinline
	preload="auto"
></video>

<div class="fdn-intro" id="fdn-intro" role="presentation">
	<p class="fdn-intro__text" id="fdn-intro-text" aria-label={introWords.join(" ")}>
		{introWords.map((word) => (
			<span class="fdn-intro__word">{word}</span>
		))}
	</p>
</div>

<style>
	@font-face {
		font-family: "National Compressed";
		src: url("/fonts/TestNational2Compressed-Regular.otf") format("opentype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National Compressed";
		src: url("/fonts/TestNational2Compressed-RegularItalic.otf") format("opentype");
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	/* ── PAGE CONTENT (bottom layer) ── */
	.fdn-shell {
		position: relative;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
	}

	.fdn-page {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
	}

	.fdn-page__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	/* ── HERO OVERLAY COPY ── */
	.fdn-hero-copy {
		position: absolute;
		z-index: 1;
		left: clamp(3rem, 1.5rem + 7vw, 8rem);
		top: 50%;
		transform: translateY(-50%);
		max-width: 38rem;
		color: #fff;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
		background: rgb(24 47 86 / 80%);
		padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
		border-radius: 0 64px 0 64px;
	}

	.fdn-hero-copy__title {
		margin: 0 0 1.5rem;
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-size: clamp(2.5rem, 1.5rem + 5vw, 4.5rem);
		font-weight: 400;
		font-synthesis: none;
		line-height: 0.85;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.fdn-hero-copy__kicker {
		margin: 0 0 1rem;
		font-family: "Gotham Bold", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
		font-weight: 700;
		line-height: 1.4;
	}

	.fdn-hero-copy__body {
		margin: 0;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.875rem, 0.82rem + 0.2vw, 1rem);
		font-weight: 400;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.9);
	}

	/* ── HERO OVERLAY STATS ── */
	.fdn-hero-stats {
		position: absolute;
		z-index: 1;
		right: clamp(1.5rem, 1rem + 3vw, 4.5rem);
		bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
		display: flex;
		gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
		margin: 0;
		color: #fff;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
	}

	.fdn-hero-stats__item {
		border-left: 2px solid rgba(255, 255, 255, 0.85);
		padding-left: 0.75em;
	}

	.fdn-hero-stats__value {
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
		font-weight: 400;
		font-synthesis: none;
		line-height: 1;
	}

	.fdn-hero-stats__label {
		margin: 0.4em 0 0;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem);
		font-weight: 400;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	@media (max-width: 720px) {
		.fdn-hero-copy {
			top: auto;
			bottom: 9rem;
			transform: none;
			max-width: calc(100% - 3rem);
		}

		.fdn-hero-stats {
			right: 1.5rem;
			left: 1.5rem;
			bottom: 1.5rem;
			gap: 1.25rem;
			justify-content: space-between;
		}
	}

	/* ── PROGRAMS SPLIT SECTION ── */
	.fdn-programs {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 1rem + 5vw, 5.5rem);
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(3rem, 2rem + 4vw, 6rem) clamp(1.5rem, 1rem + 3vw, 4rem);
		background: #fff;
	}

	.fdn-programs__text {
		max-width: 26rem;
	}

	.fdn-programs__title {
		margin: 0 0 1.5rem;
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-style: italic;
		font-weight: 400;
		font-synthesis: none;
		font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
		line-height: 1.1;
		color: #111318;
	}

	.fdn-programs__body {
		margin: 0 0 2rem;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
		font-weight: 400;
		line-height: 1.65;
		color: #1f2430;
	}

	.fdn-programs__link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
		font-size: 0.9375rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #111318;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.fdn-programs__link svg {
		width: 1.4em;
		height: 1.4em;
	}

	.fdn-programs__link:hover {
		color: #3d7cb3;
	}

	.fdn-programs__media {
		width: 100%;
		height: clamp(20rem, 60vh, 36rem);
		overflow: hidden;
		border-radius: 64px 0 64px 0;
	}

	.fdn-programs__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	@media (max-width: 860px) {
		.fdn-programs {
			grid-template-columns: 1fr;
		}

		.fdn-programs__text {
			max-width: none;
		}

		.fdn-programs__media {
			height: 22rem;
		}
	}

	/* ── FOUNDATION NAV ── */
	.fdn-nav {
		--fdn-nav-font: Arial, "Helvetica Neue", Helvetica, sans-serif;
		--fdn-nav-ink: #1a1a1a;
		--fdn-nav-muted: #4b5563;
		--fdn-nav-blue: #5b9bd5;
		--fdn-nav-blue-deep: #3d7cb3;

		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1;
		width: 100%;
		background: rgb(247 248 250 / 90%);
		border-bottom: 3px solid #111;
	}

	.fdn-nav__brand-row {
		display: flex;
		justify-content: center;
		padding: 1.5rem 1.5rem 1.25rem;
	}

	.fdn-nav__brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
	}

	.fdn-nav__brand-mark {
		display: block;
		width: clamp(6rem, 4rem + 6vw, 8rem);
		height: auto;
	}

	.fdn-nav__brand-word {
		font-family: var(--fdn-nav-font);
		font-size: clamp(0.9rem, 0.8rem + 0.3vw, 1rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fdn-nav-ink);
	}

	.fdn-nav__rule {
		margin: 0 auto;
		max-width: 70rem;
		border: none;
		border-top: 1px solid #d7dade;
	}

	.fdn-nav__links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem);
		max-width: 70rem;
		margin: 0 auto;
		padding: 1rem 1.5rem;
	}

	.fdn-nav__spacer {
		width: clamp(1.5rem, 1rem + 2vw, 3rem);
	}

	.fdn-nav__link {
		font-family: var(--fdn-nav-font);
		font-size: clamp(0.9375rem, 0.875rem + 0.2vw, 1rem);
		font-weight: 700;
		color: var(--fdn-nav-ink);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	.fdn-nav__link:hover {
		color: var(--fdn-nav-blue-deep);
	}

	.fdn-nav__donate {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.6em 1.25em;
		font-family: var(--fdn-nav-font);
		font-size: clamp(0.875rem, 0.82rem + 0.2vw, 0.9375rem);
		font-weight: 700;
		color: #fff;
		background: var(--fdn-nav-blue);
		text-decoration: none;
		border-radius: 4px;
		white-space: nowrap;
		transition: background 0.15s ease;
	}

	.fdn-nav__donate:hover {
		background: var(--fdn-nav-blue-deep);
	}

	@media (max-width: 720px) {
		.fdn-nav__links {
			flex-wrap: wrap;
			row-gap: 0.75rem;
		}

		.fdn-nav__spacer {
			display: none;
		}

		.fdn-nav__donate {
			width: 100%;
		}
	}

	/* ── VIDEO (middle layer) ── */
	.fdn-video {
		position: fixed;
		inset: 0;
		z-index: 1;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		object-fit: cover;
		background: #000;
		opacity: 1;
		transition: opacity 1.1s ease;
	}

	.fdn-video.is-hidden {
		opacity: 0;
		pointer-events: none;
	}

	/* ── INTRO OVERLAY (top layer) ── */
	.fdn-intro {
		position: fixed;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		background: rgb(24 47 86);
		padding: 0 1.5rem;
		opacity: 1;
		transition: opacity 1s ease;
	}

	.fdn-intro.is-hidden {
		opacity: 0;
		pointer-events: none;
	}

	.fdn-intro__text {
		margin: 0;
		max-width: 44rem;
		text-align: center;
		font-family: "Gotham Bold", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(1.5rem, 1rem + 3vw, 3rem);
		font-weight: 700;
		line-height: 1.3;
		color: #fff;
	}

	.fdn-intro__word {
		display: inline-block;
		margin: 0 0.28em 0.15em 0;
		opacity: 0;
		transform: translateY(0.4em);
		transition: opacity 0.45s ease, transform 0.45s ease;
	}

	.fdn-intro__word.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.fdn-intro,
		.fdn-video,
		.fdn-intro__word {
			transition: none;
		}
	}
</style>

<script>
	const intro = document.getElementById("fdn-intro");
	const words = document.querySelectorAll<HTMLElement>(".fdn-intro__word");
	const video = document.getElementById("fdn-video") as HTMLVideoElement;

	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const wordStagger = 220;
	const postTypeDelay = 1000;
	const wordTransitionDuration = 450;
	const videoPlaybackDuration = 5000;

	const revealWord = (index: number) => {
		words[index]?.classList.add("is-visible");
	};

	const hideIntro = () => {
		intro?.classList.add("is-hidden");
		video?.play().catch(() => {
			/* autoplay can be blocked; the video simply stays paused on first frame */
		});
		setTimeout(hideVideo, videoPlaybackDuration);
	};

	const hideVideo = () => {
		video?.classList.add("is-hidden");
	};

	if (prefersReducedMotion) {
		words.forEach((word) => word.classList.add("is-visible"));
		intro?.classList.add("is-hidden");
		video?.classList.add("is-hidden");
	} else {
		words.forEach((_, index) => {
			setTimeout(() => revealWord(index), index * wordStagger);
		});

		const typingDuration = (words.length - 1) * wordStagger + wordTransitionDuration;
		setTimeout(hideIntro, typingDuration + postTypeDelay);

		video?.addEventListener("ended", hideVideo);
	}
</script>

</body>
</html>

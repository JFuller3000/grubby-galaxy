---
const introWords = "Building a Stronger Safer Pilot Community".split(" ");

const navLinks = ["Programs", "Ways To Give"];
const navLinksSecondary = ["About", "Contact Us"];

const heroSlides = [
	"/images/foundation/slideshow/03-295_085.jpg",
	"/images/foundation/slideshow/04-368_075.jpg",
	"/images/foundation/slideshow/11-798_3241.jpg",
	"/images/foundation/slideshow/25_Montana Floatplanes 0720.jpg",
].map((src) => encodeURI(src));
---

<!DOCTYPE html>
<html lang="en" class="fdn-scroll-lock">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>AOPA Foundation</title>
</head>
<body>

<div class="fdn-shell">
	<header class="fdn-nav">
		<div class="fdn-nav__brand-row">
			<a href="/aopa/foundation" class="fdn-nav__brand">
				<img
					class="fdn-nav__brand-mark"
					src="/images/aopa-wings-logo-blue.svg"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span class="fdn-nav__brand-word">AOPA Foundation</span>
			</a>
		</div>
		<hr class="fdn-nav__rule" />
		<nav class="fdn-nav__links" aria-label="Foundation navigation">
			{navLinks.map((label) => (
				<a href="#" class="fdn-nav__link">{label}</a>
			))}
			<span class="fdn-nav__spacer" aria-hidden="true"></span>
			{navLinksSecondary.map((label) => (
				<a href="#" class="fdn-nav__link">{label}</a>
			))}
			<a href="#" class="fdn-nav__donate">Donate Today</a>
		</nav>
	</header>

	<section class="fdn-page">
		<div class="fdn-hero-slides" id="fdn-hero-slides">
			{heroSlides.map((src, index) => (
				<img
					class:list={["fdn-hero-slide", index === 0 && "is-active"]}
					src={src}
					alt=""
					loading={index === 0 ? "eager" : "lazy"}
					decoding="async"
				/>
			))}
		</div>

		<div class="fdn-hero-copy">
			<h1 class="fdn-hero-copy__title">AOPA<br />Foundation</h1>
			<p class="fdn-hero-copy__kicker">The Philanthropic Arm of AOPA</p>
			<p class="fdn-hero-copy__body">
				Your contributions fund programs that membership dues don’t cover, including the AOPA Air Safety Institute and You Can Fly program. Our goal is to fund opportunities of growth for every AOPA member and the entire general aviation community. 
			</p>
		</div>

		<dl class="fdn-hero-stats">
			<div class="fdn-hero-stats__item">
				<dt class="fdn-hero-stats__value">5K</dt>
				<dd class="fdn-hero-stats__label">Lorem<br />Ipsums</dd>
			</div>
			<div class="fdn-hero-stats__item">
				<dt class="fdn-hero-stats__value">32</dt>
				<dd class="fdn-hero-stats__label">Dolorum<br />Estis</dd>
			</div>
			<div class="fdn-hero-stats__item">
				<dt class="fdn-hero-stats__value">231</dt>
				<dd class="fdn-hero-stats__label">Amet<br />Consectus</dd>
			</div>
		</dl>

		<div class="fdn-hero-timer" aria-hidden="true">
			<div class="fdn-hero-timer__bar" id="fdn-hero-timer-bar"></div>
		</div>
	</section>
</div>

<section class="fdn-programs">
	<div class="fdn-programs__text">
		<h2 class="fdn-programs__title">AOPA Foundation Programs</h2>
		<p class="fdn-programs__body">
			This isn't just about getting people interested in aviation; it's about giving them a way
			in. AOPA Foundation Aviation Programs connect students, educators, and pilots with real
			opportunities to learn, grow, and take action. Built on experience and driven by impact,
			these initiatives open doors at every stage of the aviation journey.
		</p>
		<a href="#" class="fdn-programs__link">
			Learn More
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 12h13M13 6l7 6-7 6"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</a>
	</div>
	<div class="fdn-programs__media">
		<img
			class="fdn-programs__image"
			src="/images/foundation/11r-367_036.jpg"
			alt=""
			loading="lazy"
			decoding="async"
		/>
	</div>
</section>

<section class="fdn-impact">
	<div class="fdn-impact__inner">
		<h2 class="fdn-impact__title">Our Impact</h2>
		<div class="fdn-impact__grid">
			<div class="fdn-impact__card fdn-impact__card--highlight">
				<span class="fdn-impact__value" data-count-to="7000">7,000</span>
				<span class="fdn-impact__label">Lorem Ipsums</span>
			</div>
			<div class="fdn-impact__card">
				<span class="fdn-impact__value" data-count-to="328" data-count-suffix="k">328k</span>
				<span class="fdn-impact__label">Lorem Ipsums</span>
			</div>
			<div class="fdn-impact__card">
				<span class="fdn-impact__value" data-count-to="97">97</span>
				<span class="fdn-impact__label">Lorem Ipsums</span>
			</div>
		</div>
	</div>
</section>

<section class="fdn-scholarship">
	<div class="fdn-scholarship__media">
		<img
			class="fdn-scholarship__image"
			src="/images/foundation/23_eFIRC0619-web.jpg"
			alt=""
			loading="lazy"
			decoding="async"
		/>
	</div>
	<div class="fdn-scholarship__text">
		<h2 class="fdn-scholarship__title">Flight Training Scholarships</h2>
		<p class="fdn-scholarship__body">
			The scholarship program helps student pilots to succeed, eases the financial burden of
			flight training, and ultimately adds to the pilot population.
		</p>
		<a href="#" class="fdn-scholarship__link">
			Learn More
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 12h13M13 6l7 6-7 6"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</a>
	</div>
</section>

<section class="fdn-volunteer">
	<div class="fdn-volunteer__text">
		<h2 class="fdn-volunteer__title">Volunteer Program</h2>
		<p class="fdn-volunteer__body">
			Remember what sparked your interest in aviation? Now you can be that moment for someone
			else. Join AOPA members connecting with students across the country—sharing real
			experiences, bringing classroom learning to life, and making a lasting impact.
		</p>
		<a href="#" class="fdn-volunteer__link">
			Learn More
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 12h13M13 6l7 6-7 6"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</a>
	</div>
	<div class="fdn-volunteer__media">
		<img
			class="fdn-volunteer__image"
			src="/images/foundation/23_Essex-Model-Shoot0006-web.jpg"
			alt=""
			loading="lazy"
			decoding="async"
		/>
	</div>
</section>

<section class="fdn-give">
	<div class="fdn-give__inner">
		<div class="fdn-give__text">
			<h2 class="fdn-give__title">Ways to Give</h2>
			<p class="fdn-give__body">
				There are many ways to support the AOPA Foundation, and every contribution counts.
				Whether it's a one-time or annual gift, there is a level to suit every philanthropic
				preference.
			</p>
		</div>
		<a href="#" class="fdn-give__cta">Learn More</a>
	</div>
</section>

<section class="fdn-sponsors">
	<h2 class="fdn-sponsors__title">Thank You to Our Corporate Sponsors</h2>
	<div class="fdn-sponsors__grid">
		<div class="fdn-sponsors__logo" aria-hidden="true"></div>
		<div class="fdn-sponsors__logo" aria-hidden="true"></div>
	</div>
</section>

<video
	class="fdn-video"
	id="fdn-video"
	src="/images/foundation/hero-video-desktop-3.mp4"
	muted
	playsinline
	preload="auto"
></video>

<div class="fdn-intro" id="fdn-intro" role="presentation">
	<p class="fdn-intro__text" id="fdn-intro-text" aria-label={introWords.join(" ")}>
		{introWords.map((word) => (
			<span class="fdn-intro__word">{word}</span>
		))}
	</p>
</div>

<style>
	@font-face {
		font-family: "National Compressed";
		src: url("/fonts/TestNational2Compressed-Regular.otf") format("opentype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "National Compressed";
		src: url("/fonts/TestNational2Compressed-RegularItalic.otf") format("opentype");
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html, body {
		margin: 0;
		padding: 0;
		background: #fff;
	}

	html.fdn-scroll-lock,
	html.fdn-scroll-lock body {
		overflow: hidden;
		height: 100%;
	}

	/* ── PAGE CONTENT (bottom layer) ── */
	.fdn-shell {
		position: relative;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
	}

	.fdn-page {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
	}

	/* ── HERO SLIDESHOW ── */
	.fdn-hero-slides {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.fdn-hero-slide {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 1.5s ease;
	}

	.fdn-hero-slide.is-active {
		opacity: 1;
	}

	/* ── HERO SLIDESHOW TIMER ── */
	.fdn-hero-timer {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		height: 4px;
		background: rgba(255, 255, 255, 0.25);
	}

	.fdn-hero-timer__bar {
		height: 100%;
		width: 0%;
		background: #fff;
	}

	@media (prefers-reduced-motion: reduce) {
		.fdn-hero-slide {
			transition: none;
		}
	}

	/* ── HERO OVERLAY COPY ── */
	.fdn-hero-copy {
		position: absolute;
		z-index: 1;
		left: clamp(3rem, 1.5rem + 7vw, 8rem);
		top: 50%;
		transform: translateY(-50%);
		max-width: 38rem;
		color: #fff;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
		background: rgb(24 47 86 / 80%);
		padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
		border-radius: 0 64px 0 64px;
	}

	.fdn-hero-copy__title {
		margin: 0 0 1.5rem;
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-size: clamp(2.5rem, 1.5rem + 5vw, 4.5rem);
		font-weight: 400;
		font-synthesis: none;
		line-height: 0.85;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.fdn-hero-copy__kicker {
		margin: 0 0 1rem;
		font-family: "Gotham Bold", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
		font-weight: 700;
		line-height: 1.4;
	}

	.fdn-hero-copy__body {
		margin: 0;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.875rem, 0.82rem + 0.2vw, 1rem);
		font-weight: 400;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.9);
	}

	/* ── HERO OVERLAY STATS ── */
	.fdn-hero-stats {
		position: absolute;
		z-index: 1;
		right: clamp(1.5rem, 1rem + 3vw, 4.5rem);
		bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
		display: flex;
		gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
		margin: 0;
		color: #fff;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
	}

	.fdn-hero-stats__item {
		border-left: 2px solid rgba(255, 255, 255, 0.85);
		padding-left: 0.75em;
	}

	.fdn-hero-stats__value {
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
		font-weight: 400;
		font-synthesis: none;
		line-height: 1;
	}

	.fdn-hero-stats__label {
		margin: 0.4em 0 0;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem);
		font-weight: 400;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	@media (max-width: 720px) {
		.fdn-hero-copy {
			top: auto;
			bottom: 9rem;
			transform: none;
			max-width: calc(100% - 3rem);
		}

		.fdn-hero-stats {
			right: 1.5rem;
			left: 1.5rem;
			bottom: 1.5rem;
			gap: 1.25rem;
			justify-content: space-between;
		}
	}

	/* ── PROGRAMS SPLIT SECTION ── */
	.fdn-programs {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 1rem + 5vw, 5.5rem);
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(3rem, 2rem + 4vw, 6rem) clamp(1.5rem, 1rem + 3vw, 4rem);
		background: #fff;
	}

	.fdn-programs__text {
		max-width: 26rem;
	}

	.fdn-programs__title {
		margin: 0 0 1.5rem;
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-style: italic;
		font-weight: 400;
		font-synthesis: none;
		font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
		line-height: 1.1;
		color: rgb(24 47 86);
	}

	.fdn-programs__body {
		margin: 0 0 2rem;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
		font-weight: 400;
		line-height: 1.65;
		color: #1f2430;
	}

	.fdn-programs__link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
		font-size: 0.9375rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #111318;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.fdn-programs__link svg {
		width: 1.4em;
		height: 1.4em;
	}

	.fdn-programs__link:hover {
		color: #3d7cb3;
	}

	.fdn-programs__media {
		width: 100%;
		height: clamp(20rem, 60vh, 36rem);
		overflow: hidden;
		border-radius: 64px 0 64px 0;
	}

	.fdn-programs__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	@media (max-width: 860px) {
		.fdn-programs {
			grid-template-columns: 1fr;
		}

		.fdn-programs__text {
			max-width: none;
		}

		.fdn-programs__media {
			height: 22rem;
		}
	}

	/* ── IMPACT STATS ── */
	.fdn-impact {
		background: rgb(24 47 86);
		padding: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(1.5rem, 1rem + 3vw, 4.5rem);
	}

	.fdn-impact__inner {
		max-width: 90rem;
		margin: 0 auto;
	}

	.fdn-impact__title {
		margin: 0 0 clamp(1.5rem, 1rem + 2vw, 2.5rem);
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-style: italic;
		font-weight: 400;
		font-synthesis: none;
		font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
		line-height: 1.1;
		color: #fff;
	}

	.fdn-impact__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 0.6rem + 1.5vw, 3rem);
	}

	.fdn-impact__card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: clamp(16rem, 12rem + 15vw, 26rem);
		padding: clamp(1.5rem, 1rem + 2vw, 3rem);
		background: rgba(255, 255, 255, 0.08);
	}

	.fdn-impact__card--highlight {
		background: #3d87ad;
	}

	.fdn-impact__value {
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-style: normal;
		font-weight: 400;
		font-synthesis: none;
		font-size: clamp(2.5rem, 1.8rem + 4vw, 4.5rem);
		line-height: 1;
		color: #fff;
	}

	.fdn-impact__label {
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-weight: 400;
		font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
		color: rgba(255, 255, 255, 0.92);
	}

	@media (max-width: 720px) {
		.fdn-impact__grid {
			grid-template-columns: 1fr;
		}

		.fdn-impact__card {
			min-height: 12rem;
		}
	}

	/* ── SCHOLARSHIP SPLIT SECTION ── */
	.fdn-scholarship {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
		align-items: center;
		gap: clamp(2rem, 1rem + 5vw, 5.5rem);
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(3rem, 2rem + 4vw, 6rem) clamp(1.5rem, 1rem + 3vw, 4rem) clamp(1rem, 0.5rem + 2vw, 2rem);
		background: #fff;
	}

	.fdn-scholarship__media {
		width: 100%;
		height: clamp(20rem, 60vh, 36rem);
		overflow: hidden;
		border-radius: 0 64px 0 64px;
	}

	.fdn-scholarship__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.fdn-scholarship__text {
		max-width: 26rem;
	}

	.fdn-scholarship__title {
		margin: 0 0 1.5rem;
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-style: italic;
		font-weight: 400;
		font-synthesis: none;
		font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
		line-height: 1.1;
		color: rgb(24 47 86);
	}

	.fdn-scholarship__body {
		margin: 0 0 2rem;
		font-family: "Gotham Book", Gotham, "Helvetica Neue", Arial, sans-serif;
		font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
		font-weight: 400;
		line-height: 1.65;
		color: #1f2430;
	}

	.fdn-scholarship__link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
		font-size: 0.9375rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #111318;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.fdn-scholarship__link svg {
		width: 1.4em;
		height: 1.4em;
	}

	.fdn-scholarship__link:hover {
		color: #3d7cb3;
	}

	@media (max-width: 860px) {
		.fdn-scholarship {
			grid-template-columns: 1fr;
		}

		.fdn-scholarship__text {
			max-width: none;
		}

		.fdn-scholarship__media {
			height: 22rem;
		}
	}

	/* ── VOLUNTEER SPLIT SECTION ── */
	.fdn-volunteer {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 1rem + 5vw, 5.5rem);
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(1rem, 0.5rem + 2vw, 2rem) clamp(1.5rem, 1rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 6rem);
		background: #fff;
	}

	.fdn-volunteer__text {
		max-width: 26rem;
	}

	.fdn-volunteer__title {
		margin: 0 0 1.5rem;
		font-family: "National Compressed", "Arial Narrow", "Helvetica Neue Condensed", Arial, sans-serif;
		font-style: italic;
		font-weight: 400;
		font-synthesis: none;
		font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
		line-height: 1.1;
		color: rgb(24 47 86);
	}

	.fdn-volunteer__body {
		margin: 0 0 2rem;

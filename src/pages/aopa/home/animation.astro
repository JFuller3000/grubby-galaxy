<!DOCTYPE html>
<html lang="en" class="snap-y snap-mandatory">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>AOPA Home — Animation</title>
</head>
<body>

<main class="w-full bg-white">
	<section class="grid h-screen w-full snap-start place-items-center">
		<a
			href="#"
			class="js-plane-btn relative inline-flex items-center gap-2 rounded-full bg-[#182f56] py-2 pl-12 pr-2 no-underline"
		>
			<span class="relative inline-flex items-center gap-2">
				<span class="js-plane-word relative inline-block font-sans text-[1.0625rem] font-extrabold uppercase tracking-widest text-white">
					Go
				</span>
				<span
					class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
					aria-hidden="true"
				>
				<span
					class="js-plane-flair grid h-8 w-8 place-items-center text-[#5b9bd5] opacity-0"
				>
					<svg viewBox="0 0 32 32" fill="currentColor" class="h-full w-full">
						<path d="M30.79,10.85l-2.33-2.99v-.02c-1.57-1.92-4.3-2.4-6.42-1.14l-6.45,3.85-6.74-2.48c-.23-.08-.47-.08-.7,0l-.9.34-.04.02c-1.02.44-1.48,1.61-1.05,2.63.11.26.28.49.48.68l2.73,2.65-2.52,1.52-3.53-1.19c-.25-.08-.52-.07-.76.05l-.38.18c-1.01.45-1.46,1.63-1.01,2.64.11.24.26.45.45.63l4.5,4.41h.01c.92.89,2.14,1.37,3.41,1.37.89,0,1.76-.24,2.53-.69l18.43-11c.47-.28.63-.9.35-1.37-.02-.04-.04-.07-.07-.1h0Z" />
					</svg>
				</span>
				</span>
				<span class="js-plane-word relative inline-block font-sans text-[1.0625rem] font-extrabold uppercase tracking-widest text-white">
					Fly
				</span>
			</span>
			<span
				class="js-plane-icon relative ml-6 grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white text-[#182f56]"
				aria-hidden="true"
			>
				<svg class="js-plane-arrow h-10 w-10 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
					<polygon
						fill="currentColor"
						points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
					/>
				</svg>
			</span>
		</a>
	</section>

	<section class="grid h-screen w-full snap-start place-items-center">
		<a
			href="#"
			class="js-learn-more relative inline-flex items-center gap-5 overflow-hidden rounded-full bg-[#182f56] py-2 pl-12 pr-2 no-underline"
		>
			<span
				class="js-learn-more-flair pointer-events-none absolute inset-0 origin-top-left scale-0 will-change-transform"
				aria-hidden="true"
			>
				<span class="absolute left-0 top-0 aspect-square w-[260%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#5b9bd5]"></span>
			</span>
			<span
				class="js-learn-more-label relative font-sans text-[1.0625rem] font-extrabold uppercase tracking-widest text-white pr-4 transition-colors duration-150"
			>
				Join Now
			</span>
			<span
				class="js-learn-more-icon relative grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white text-[#182f56]"
				aria-hidden="true"
			>
				<svg class="js-learn-more-arrow h-10 w-10 rotate-45" viewBox="0 0 41.69 43.1" fill="none">
					<polygon
						fill="currentColor"
						points="30.75 21.39 27.61 18.25 24.66 15.09 24.85 17.26 24.83 43.05 16.76 43.1 16.77 17.45 16.82 15.38 12.56 19.77 0 32.33 0 20.83 5.47 15.32 8.82 12 12.8 7.99 20.87 0 41.68 20.8 41.69 32.33 38.04 28.68 30.75 21.39"
					/>
				</svg>
			</span>
		</a>
	</section>
</main>

<style>
	.js-learn-more:hover .js-learn-more-label {
		color: #182f56;
	}
</style>

<script>
	import { gsap } from "gsap";

	class FlairButton {
		private readonly button: HTMLElement;
		private readonly flair: HTMLElement;
		private readonly icon: HTMLElement;
		private readonly arrow: SVGElement;
		private readonly xSet: (value: number) => void;
		private readonly ySet: (value: number) => void;
		private arrowRotation = 45;

		constructor(button: HTMLElement) {
			this.button = button;
			this.flair = button.querySelector<HTMLElement>(".js-learn-more-flair")!;
			this.icon = button.querySelector<HTMLElement>(".js-learn-more-icon")!;
			this.arrow = button.querySelector<SVGElement>(".js-learn-more-arrow")!;
			this.xSet = gsap.quickSetter(this.flair, "xPercent") as (value: number) => void;
			this.ySet = gsap.quickSetter(this.flair, "yPercent") as (value: number) => void;
			gsap.set(this.arrow, { rotation: this.arrowRotation, transformOrigin: "50% 50%" });
			this.initEvents();
		}

		private getXY(e: MouseEvent) {
			const { left, top, width, height } = this.button.getBoundingClientRect();

			const xTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, width, 0, 100),
				gsap.utils.clamp(0, 100),
			);
			const yTransformer = gsap.utils.pipe(
				gsap.utils.mapRange(0, height, 0, 100),
				gsap.utils.clamp(0, 100),
			);

			return {
				x: xTransformer(e.clientX - left),
				y: yTransformer(e.clientY - top),
			};
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				this.xSet(x);
				this.ySet(y);

				gsap.to(this.flair, { scale: 1, duration: 0.4, ease: "power2.out" });

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation += 45;

				const tl = gsap.timeline();
				tl.to(this.icon, { scale: 1.15, duration: 0.25, ease: "power2.out" }, 0)
					.to(this.icon, { scale: 1, duration: 0.6, ease: "elastic.out(1, 0.35)" }, 0.25)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.6, ease: "power3.out" }, 0);
			});

			this.button.addEventListener("mouseleave", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.killTweensOf(this.flair);

				gsap.to(this.flair, {
					xPercent: x > 90 ? x + 20 : x < 10 ? x - 20 : x,
					yPercent: y > 90 ? y + 20 : y < 10 ? y - 20 : y,
					scale: 0,
					duration: 0.3,
					ease: "power2.out",
				});

				gsap.killTweensOf([this.icon, this.arrow]);
				this.arrowRotation = 45;
				gsap.to(this.icon, { scale: 1, duration: 0.3, ease: "power2.out" });
				gsap.to(this.arrow, { rotation: this.arrowRotation, duration: 0.4, ease: "power2.out" });
			});

			this.button.addEventListener("mousemove", (e) => {
				const { x, y } = this.getXY(e as MouseEvent);
				gsap.to(this.flair, { xPercent: x, yPercent: y, duration: 0.4, ease: "power2" });
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-learn-more").forEach((button) => new FlairButton(button));

	class PlaneButton {
		private readonly button: HTMLElement;
		private readonly words: HTMLElement[];
		private readonly flair: HTMLElement;
		private readonly icon: HTMLElement;
		private readonly arrow: SVGElement;
		private arrowRotation = 45;

		constructor(button: HTMLElement) {
			this.button = button;
			this.words = Array.from(button.querySelectorAll<HTMLElement>(".js-plane-word"));
			this.flair = button.querySelector<HTMLElement>(".js-plane-flair")!;
			this.icon = button.querySelector<HTMLElement>(".js-plane-icon")!;
			this.arrow = button.querySelector<SVGElement>(".js-plane-arrow")!;
			gsap.set(this.arrow, { rotation: this.arrowRotation, transformOrigin: "50% 50%" });
			this.initEvents();
		}

		private initEvents() {
			this.button.addEventListener("mouseenter", () => {
				gsap.killTweensOf([...this.words, this.flair, this.icon, this.arrow]);
				gsap.set(this.flair, { x: 0, y: 0, rotation: 0, scale: 0, opacity: 0 });
				this.arrowRotation += 45;

				const tl = gsap.timeline();
				tl.to(this.words[0], { x: -14, duration: 0.7, ease: "elastic.out(1, 0.5)" }, 0)
					.to(this.words[1], { x: 14, duration: 0.7, ease: "elastic.out(1, 0.5)" }, 0)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.6, ease: "power3.out" }, 0)
					// anticipation: rise straight up level, like a helicopter, and bounce into place
					.to(
						this.flair,
						{ y: -22, rotation: 0, scale: 1, opacity: 1, duration: 0.5, ease: "elastic.out(1, 0.5)" },
						0.1,
					)
					// then, with no delay, slowly climb away on that upward angle while fading out
					.to(this.flair, { x: 130, y: -130, rotation: -14, opacity: 0, duration: 1.5, ease: "sine.inOut" })
					// once the plane is gone, elastic the words back to their starting position
					.to(this.words, { x: 0, duration: 0.6, ease: "elastic.out(1, 0.5)" });
			});

			this.button.addEventListener("mouseleave", () => {
				gsap.killTweensOf([...this.words, this.flair, this.icon, this.arrow]);
				this.arrowRotation = 45;

				const tl = gsap.timeline();
				tl.to(this.words, { x: 0, duration: 0.3, ease: "power2.out" }, 0)
					.to(
						this.flair,
						{ x: 0, y: 0, rotation: 0, scale: 0, opacity: 0, duration: 0.3, ease: "power2.in" },
						0,
					)
					.to(this.arrow, { rotation: this.arrowRotation, duration: 0.4, ease: "power2.out" }, 0);
			});
		}
	}

	document.querySelectorAll<HTMLElement>(".js-plane-btn").forEach((button) => new PlaneButton(button));
</script>

</body>
</html>
